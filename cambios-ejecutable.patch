+/** Pide las estadísticas a /api/stats. Si no hay datos reales pero sí de demostración, abre la demostración. */
+async function cargar(inicial = false) {
+  let s;
+  try {
+    const r = await fetch("/api/stats?datos=" + ctx.fuente);
