+let cargaXlsx;
+/** Carga la librería para leer Excel la primera vez que se necesita. */
+function cargarXlsx() {
+  if (window.XLSX) return Promise.resolve();
+  cargaXlsx ||= new Promise((ok, mal) => {
+    const s = document.createElement("script");
+    s.src = "js/vendor/xlsx.full.min.js";
+    s.onload = ok;
