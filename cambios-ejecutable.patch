+
+  $("reg-meta").textContent = E.q.trim() ? `${lista.length} de ${total}` : `${total} ${total === 1 ? "registro" : "registros"}`;
+
+  if (!fila.length) {
+    $("reg-tabla").innerHTML = total
+      ? '<p class="vacio reg-vacio">Ningún registro coincide con la búsqueda.</p>'
+      : `<p class="vacio reg-vacio">Todavía no hay ${k === "simulaciones" ? "simulaciones guardadas" : "respuestas"} en este origen de datos.</p>`;
+  } else {
+    const cols = COLUMNAS[k];
+    $("reg-tabla").innerHTML =
+      `<div class="scroll"><table class="tabla texto reg"><thead><tr>${cols.map(([t]) => `<th>${t}</th>`).join("")}<th class="acc">Acciones</th></tr></thead><tbody>` +
+      fila
+        .map((r) => {
+          const acc =
+            `<button type="button" class="btn btn-sm" data-acc="ver" data-id="${esc(r.id)}">Ver</button>` +
+            (k === "simulaciones" ? "" : `<button type="button" class="btn btn-sm" data-acc="editar" data-id="${esc(r.id)}">Editar</button>`) +
+            `<button type="button" class="btn btn-sm btn-peligro" data-acc="borrar" data-id="${esc(r.id)}">Eliminar</button>`;
+          return `<tr>${cols.map(([, f]) => `<td>${f(r)}</td>`).join("")}<td class="acc"><div>${acc}</div></td></tr>`;
+        })
+        .join("") +
+      "</tbody></table></div>";
+  }
+
+  $("reg-pie").hidden = lista.length <= TAM;
+  $("reg-pie").innerHTML =
+    `<span>Mostrando ${desde + 1}–${desde + fila.length} de ${lista.length}</span><span class="sp"></span>` +
+    `<button type="button" class="btn btn-sm" data-pag="-1"${E.pag <= 1 ? " disabled" : ""}>Anterior</button>` +
+    `<span>Página ${E.pag} de ${paginas}</span>` +
+    `<button type="button" class="btn btn-sm" data-pag="1"${E.pag >= paginas ? " disabled" : ""}>Siguiente</button>`;
+}
+
+/** Trae de la base de datos las tres listas del origen de datos elegido. Se llama cada vez que se abre la pantalla. */
+export async function cargarRegistros(contexto) {
+  ctx = contexto || ctx;
+  if (!E.cargado) {
+    E.error = "";
+    pintarCascaron();
+  }
+  try {
+    const f = encodeURIComponent(ctx.fuente);
+    E.datos.titulados = await api(`/titulados?datos=${f}`, {}, "titulados");
+    E.datos.empleadores = await api(`/empleadores?datos=${f}`, {}, "empleadores");
+    E.datos.simulaciones = agruparSimulaciones(await api(`/simulaciones?datos=${f}`, {}, "simulaciones"));
+    E.cargado = true;
+    E.error = "";
+  } catch (x) {
+    if (E.cargado) avisar(x.message, "mal");
+    else E.error = x.message;
+  }
+  pintarCascaron();
+}
+
+// ---------------------------------------------------------------------------
+// Diálogos: ver, editar y eliminar
+// ---------------------------------------------------------------------------
+
+function abrir(html, { cierraConFondo = true } = {}) {
+  dlg.innerHTML = html;
+  dlg.dataset.fondo = cierraConFondo ? "1" : "";
+  if (!dlg.open) dlg.showModal();
+}
+const cerrar = () => {
+  if (dlg.open) dlg.close();
+};
+
+const cabecera = (titulo, sub) =>
+  `<header class="dlg-cab"><div><h2 id="dlg-titulo">${esc(titulo)}</h2>${sub ? `<p>${sub}</p>` : ""}</div>` +
+  `<button type="button" class="dlg-x" data-cerrar aria-label="Cerrar">×</button></header>`;
+
+/** Ficha de solo lectura de una simulación guardada: parámetros y resultados de cada escenario y de cada área. */
+function verSimulacion(r) {
+  const t = r.todas[0] || {};
+  const parametros = [
+    ["Datos usados", `${r.datos} (${r.nTitulados} titulados)`],
+    ["Origen de la probabilidad de interés", t.origenInteres === "manual" ? "Manual" : "Calculada con las respuestas"],
+    ["Población de titulados", t.poblacion],
+    ["Mínimo de inscritos para abrir", r.minimo],
+    ["Repeticiones por escenario", t.iteraciones],
+  ]
+    .map(([a, b]) => `<dt>${esc(a)}</dt><dd>${esc(b ?? "—")}</dd>`)
+    .join("");
+  // Una fila por escenario y por área: primero el programa en general, luego las áreas en orden alfabético
+  const orden = (e) => (e.escenario === "base" ? 0 : e.escenario === "becas" ? 1 : 2);
+  const filas = [...r.todas]
+    .sort((a, b) => (a.area || "").localeCompare(b.area || "") || orden(a) - orden(b))
+    .map(
+      (f) =>
+        `<tr><td>${esc(f.area || "Programa en general")}</td><td>${esc(f.escenario)}</td>` +
+        `<td>${num(f.probInteres * 100, 0)} %</td><td>${num(f.probInscribe * 100, 0)} %</td>` +
+        `<td>${num(f.media, 0)}</td><td>${num(f.p5, 0)} – ${num(f.p95, 0)}</td><td>${num(f.probApertura * 100, 0)} %</td></tr>`
+    )
+    .join("");
+  dlg.dataset.id = r.id;
+  abrir(
+    `<div class="dlg-form">${cabecera(nombre("simulaciones", r), `${r.filas} filas · ${r.demo ? "calculada con datos de demostración" : "calculada con datos reales"}`)}` +
+      `<div class="dlg-cuerpo"><section class="det-grupo"><h4>Parámetros</h4><dl class="det">${parametros}</dl></section>` +
+      `<section class="det-grupo"><h4>Resultados</h4><div class="scroll"><table class="tabla texto reg"><thead><tr>` +
+      `<th>Programa</th><th>Escenario</th><th>Interés</th><th>Se inscribe</th><th>Inscritos (media)</th><th>Rango 5–95 %</th><th>Prob. de abrir</th>` +
+      `</tr></thead><tbody>${filas}</tbody></table></div></section></div>` +
+      `<footer class="dlg-pie"><button type="button" class="btn btn-peligro" data-ir="borrar">Eliminar</button><span class="sp"></span>` +
+      `<button type="button" class="btn btn-primario" data-cerrar>Cerrar</button></footer></div>`
+  );
+}
+
+/** Ficha de solo lectura con todas las respuestas, agrupadas por paso de la encuesta. */
+function ver(id) {
+  const k = E.k;
+  const r = buscar(id);
+  if (!r) return;
+  if (k === "simulaciones") return verSimulacion(r);
+  const grupos = PASOS[k]
+    .map((s) => {
+      const filas = s.c
+        .filter((c) => r[c.n] != null && r[c.n] !== "")
+        .map((c) => `<dt title="${esc(c.l)}">${esc(etiqueta(k, c))}</dt><dd>${esc(textoRespuesta(c, r[c.n]))}</dd>`)
+        .join("");
+      return filas ? `<section class="det-grupo"><h4>${esc(s.t)}</h4><dl class="det">${filas}</dl></section>` : "";
+    })
+    .join("");
+  dlg.dataset.id = id;
+  abrir(
+    `<div class="dlg-form">${cabecera(nombre(k, r), `Registro n.º ${r.id} · guardado el ${esc(fechaHora(r.registrado))} · ${r.demo ? "respuesta de demostración" : "respuesta real"}`)}` +
+      `<div class="dlg-cuerpo">${grupos}</div>` +
+      `<footer class="dlg-pie"><button type="button" class="btn btn-peligro" data-ir="borrar">Eliminar</button><span class="sp"></span>` +
+      `<button type="button" class="btn" data-cerrar>Cerrar</button><button type="button" class="btn btn-primario" data-ir="editar">Editar</button></footer></div>`
+  );
+}
+
+// ---- Formulario de edición ----
+
+/** Lista de selección. Si el valor guardado no está entre las opciones (por ejemplo «Otro: …»), se conserva como opción. */
+function seleccion(c, lista, actual, requerido) {
+  const cur = actual == null ? "" : String(actual);
+  const esta = cur === "" || lista.some(([v]) => String(v) === cur);
+  const ops = [["", "Sin respuesta"], ...lista, ...(esta ? [] : [[cur, `${cur} (valor registrado)`]])];
+  return (
+    `<select name="${c.n}" id="e-${c.n}"${requerido ? " required" : ""}>` +
+    ops.map(([v, t]) => `<option value="${esc(v)}"${String(v) === cur ? " selected" : ""}>${esc(t)}</option>`).join("") +
+    "</select>"
+  );
+}
+
+function control(k, c, v) {
+  const rq = esObligatorio(k, c);
+  const base = `name="${c.n}" id="e-${c.n}"${rq ? " required" : ""}`;
+  switch (c.t) {
+    case "n":
+      return `<input type="number" ${base} min="0" max="60" step="any" value="${esc(v)}">`;
+    case "t":
+      return `<input type="text" ${base} maxlength="255" value="${esc(v)}">`;
+    case "e":
+      return `<input type="email" ${base} maxlength="255" value="${esc(v)}">`;
+    case "p":
+      return `<input type="tel" ${base} maxlength="30" value="${esc(v)}">`;
+    case "a":
+      return `<textarea ${base} rows="3" maxlength="1500">${esc(v)}</textarea>`;
+    case "l4":
+      return seleccion(c, L4.map((x, j) => [j + 1, `${j + 1} · ${x}`]), v, rq);
+    case "l3":
+      return seleccion(c, L3.map(([x, val]) => [val, x]), v, rq);
+    case "m": {
+      const elegidas = v ? String(v).split("|") : [];
+      const extra = elegidas.filter((x) => !c.o.includes(x)); // respuestas escritas a mano («Otra: …»)
+      const items = [...c.o.map((x) => [x, elegidas.includes(x)]), ...extra.map((x) => [x, true])];
+      return `<div class="chk">${items.map(([x, on]) => `<label><input type="checkbox" name="${c.n}" value="${esc(x)}"${on ? " checked" : ""}><span>${esc(x)}</span></label>`).join("")}</div>`;
+    }
+    default:
+      return seleccion(c, c.o.map((x) => [x, x]), v, rq);
+  }
+}
+
+function campoEdicion(k, c, r) {
+  const corta = etiqueta(k, c);
+  const cab =
+    `<span class="cmp-t">${esc(corta)}${esObligatorio(k, c) ? ' <i title="Obligatorio">*</i>' : ""}</span>` +
+    (c.l !== corta ? `<span class="cmp-q">${esc(c.l)}</span>` : "");
+  return c.t === "m"
+    ? `<fieldset class="cmp"><legend>${cab}</legend>${control(k, c, r[c.n])}</fieldset>`
+    : `<div class="cmp"><label for="e-${c.n}">${cab}</label>${control(k, c, r[c.n])}</div>`;
+}
+
+/** Lee el formulario de edición y arma el objeto que espera la API (vacío = sin respuesta). */
+function leerFormulario(k, form) {
+  const fd = new FormData(form);
+  const o = {};
+  for (const c of CAMPOS[k]) {
+    if (c.t === "m") {
+      const l = fd.getAll(c.n);
+      if (l.length) o[c.n] = l.join("|");
+      continue;
+    }
+    const v = String(fd.get(c.n) ?? "").trim();
+    if (v === "") continue;
+    o[c.n] = NUM.includes(c.n) ? Number(v) : v;
+  }
+  return o;
+}
+
+function editar(id) {
+  const k = E.k;
+  const r = buscar(id);
+  if (!r) return;
+  dlg.dataset.id = id;
+  const grupos = PASOS[k]
+    .map((s) => `<section class="det-grupo"><h4>${esc(s.t)}</h4>${s.c.map((c) => campoEdicion(k, { ...c, o: c.o || OPC[c.n] || [] }, r)).join("")}</section>`)
+    .join("");
+  abrir(
+    `<form class="dlg-form" id="ed-form">${cabecera("Editar respuesta", esc(nombre(k, r)))}` +
+      `<div class="dlg-cuerpo">${grupos}</div><p class="dlg-err" role="alert" hidden></p>` +
+      `<footer class="dlg-pie"><span class="dlg-nota">* Obligatorio</span><span class="sp"></span>` +
+      `<button type="button" class="btn" data-cerrar>Cancelar</button><button class="btn btn-primario" data-guardar>Guardar cambios</button></footer></form>`,
+    { cierraConFondo: false } // un clic fuera no debe descartar lo escrito
+  );
+  const form = $("ed-form");
+  form.onsubmit = async (e) => {
+    e.preventDefault();
+    const err = form.querySelector(".dlg-err");
+    const btn = form.querySelector("[data-guardar]");
+    err.hidden = true;
+    btn.disabled = true;
+    btn.textContent = "Guardando…";
+    try {
+      const g = await api(`/${k}/${id}`, { method: "PUT", body: JSON.stringify(leerFormulario(k, form)) }, k);
+      const i = E.datos[k].findIndex((x) => String(x.id) === String(id));
+      if (i >= 0) E.datos[k][i] = g;
+      cerrar();
+      pintarCascaron();
+      avisar(`Cambios guardados en «${nombre(k, g)}».`, "ok");
+      alCambiar();
+    } catch (x) {
+      err.textContent = x.message;
+      err.hidden = false;
+      btn.disabled = false;
+      btn.textContent = "Guardar cambios";
+    }
+  };
+}
+
+// ---- Eliminación ----
+
+function confirmarBorrado(id) {
+  const k = E.k;
+  const r = buscar(id);
+  if (!r) return;
+  dlg.dataset.id = id;
+  const que = { titulados: "esta respuesta de titulado", empleadores: "esta respuesta de empleador", simulaciones: "esta simulación guardada" }[k];
+  const efecto =
+    k === "simulaciones"
+      ? `Se borran las ${r.filas} filas de esa comparación (escenario base y con becas, programa en general y por área) y deja de aparecer en el historial.`
+      : r.demo
+        ? "Es una respuesta de demostración. Se borra de la base de datos y de las estadísticas."
+        : "Es una respuesta real: se borra de la base de datos y desaparece de todas las estadísticas.";
+  abrir(
+    `<form class="dlg-form" id="del-form">${cabecera(`¿Eliminar ${que}?`, "")}` +
+      `<div class="dlg-cuerpo"><p class="del-nombre">${esc(nombre(k, r))}</p><p>${efecto} <b>Esta acción no se puede deshacer.</b></p></div>` +
+      `<p class="dlg-err" role="alert" hidden></p>` +
+      `<footer class="dlg-pie"><span class="sp"></span><button type="button" class="btn" data-cerrar autofocus>Cancelar</button>` +
+      `<button class="btn btn-peligro solido" data-borrar>Eliminar definitivamente</button></footer></form>`
+  );
+  $("del-form").onsubmit = async (e) => {
+    e.preventDefault();
+    const err = dlg.querySelector(".dlg-err");
+    const btn = dlg.querySelector("[data-borrar]");
+    err.hidden = true;
+    btn.disabled = true;
+    btn.textContent = "Eliminando…";
+    const quitar = () => {
+      E.datos[k] = E.datos[k].filter((x) => String(x.id) !== String(id));
+      cerrar();
+      pintarCascaron();
+    };
+    try {
+      const ruta = k === "simulaciones" ? `/simulaciones?corrida=${encodeURIComponent(id)}` : `/${k}/${id}`;
+      await api(ruta, { method: "DELETE" }, k);
+      quitar();
+      avisar(`Se eliminó «${nombre(k, r)}».`, "ok");
+      alCambiar();
+    } catch (x) {
+      if (x.codigo === 404) {
+        // Otra persona ya la había eliminado: la lista se pone al día.
+        quitar();
+        avisar(x.message, "mal");
+        alCambiar();
+        return;
+      }
+      err.textContent = x.message;
+      err.hidden = false;
+      btn.disabled = false;
+      btn.textContent = "Eliminar definitivamente";
+    }
+  };
+}
+
+// ---------------------------------------------------------------------------
+// Arranque y eventos
+// ---------------------------------------------------------------------------
+
+/** Conecta la pantalla. `cuandoCambia` se llama tras editar o eliminar para que el resto del panel recalcule. */
+export function iniciarRegistros(contexto, cuandoCambia) {
+  ctx = contexto;
+  alCambiar = cuandoCambia;
+  raiz = $("registros");
+  dlg = $("dlg");
+
+  raiz.addEventListener("click", (e) => {
+    const t = e.target.closest("[data-tab], [data-acc], [data-pag], [data-reg]");
+    if (!t) return;
+    if (t.dataset.tab) {
+      E.k = t.dataset.tab;
+      E.q = "";
+      E.pag = 1;
+      pintarCascaron();
+    } else if (t.dataset.acc) {
+      ({ ver, editar, borrar: confirmarBorrado })[t.dataset.acc](t.dataset.id);
+    } else if (t.dataset.pag) {
+      E.pag += Number(t.dataset.pag);
+      pintarTabla();
+    } else if (t.dataset.reg === "reintentar") {
+      cargarRegistros(ctx);
+    }
+  });
+
+  raiz.addEventListener("input", (e) => {
+    if (e.target.id !== "reg-q") return;
+    E.q = e.target.value;
+    E.pag = 1;
+    pintarTabla();
+  });
+
+  dlg.addEventListener("click", (e) => {
+    if (e.target === dlg) {
+      if (dlg.dataset.fondo === "1") cerrar();
+      return;
+    }
+    if (e.target.closest("[data-cerrar]")) cerrar();
+    const ir = e.target.closest("[data-ir]");
+    if (ir) ({ editar, borrar: confirmarBorrado })[ir.dataset.ir](dlg.dataset.id);
+  });
+}
diff --git a/Arcusur/app/classes/static/js/panel/simulacion.js b/Arcusur/app/classes/static/js/panel/simulacion.js
new file mode 100644
index 0000000..47f3686
--- /dev/null
+++ b/Arcusur/app/classes/static/js/panel/simulacion.js
@@ -0,0 +1,150 @@
+// Simulación Monte Carlo de la oferta de posgrado: compara el escenario base con el escenario con becas.
+
+import { $, esc, num, NOMBRE_FUENTE } from "./util.js";
+import { bloque, columnas, distSvg } from "./graficos.js";
+
+let interesEditado = false;
+
+/** Envía los parámetros a /api/simulacion y devuelve el resultado. */
+async function llamar(ctx, cuerpo) {
+  const r = await fetch("/api/simulacion?datos=" + ctx.fuente, {
+    method: "POST",
+    headers: { "Content-Type": "application/json" },
+    body: JSON.stringify(cuerpo),
+  });
+  if (!r.ok) throw new Error("simulación");
+  return r.json();
+}
+
+/** Prellena la probabilidad de interés con el valor de la encuesta, salvo que la persona ya la haya editado. */
+export function ajustarInteres(s) {
+  if (s.nTitulados && !interesEditado) {
+    $("pi").value = Math.max(0.01, s.pctInteres);
+    $("piHint").textContent = `Valor de la encuesta: ${num(s.pctInteres * 100, 0)} %`;
+  }
+}
+
+const indicador = (clase, titulo, r) =>
+  `<div class="ind ${clase}"><b>${num(r.probApertura * 100, 0)} %</b><span>${titulo}: probabilidad de abrir</span>` +
+  `<em>${num(r.media, 0)} inscritos en promedio (rango del 90 %: ${num(r.p5, 0)} a ${num(r.p95, 0)})</em></div>`;
+
+async function ejecutar(ctx, guardar) {
+  const corrida = "c" + Date.now().toString(36);
+  const b = {
+    poblacion: +$("pob").value,
+    probInteres: +$("pi").value,
+    probInscribe: +$("pr").value,
+    minimo: +$("mn").value,
+    iteraciones: 5000,
+    guardar: guardar ? 1 : 0,
+    corrida,
+  };
+  const bono = +$("bono").value;
+  const base = await llamar(ctx, { ...b, escenario: "base" });
+  const becas = await llamar(ctx, { ...b, escenario: "becas", probInscribe: Math.min(1, b.probInscribe + bono) });
+
+  const origen =
+    base.origenInteres === "datos"
+      ? `Interés tomado de ${base.nTitulados} respuestas de titulados (${NOMBRE_FUENTE[base.datos] || base.datos}).`
+      : "Interés escrito a mano.";
+
+  const porArea =
+    base.porArea && base.porArea.length
+      ? bloque({
+          titulo: "Resultado por área de posgrado",
+          meta: "Participación entre los titulados interesados",
+          cuerpo:
+            `<div class="scroll"><table class="tabla"><tr><th>Área</th><th>Participación</th><th>Inscritos (base)</th><th>Abre (base)</th><th>Inscritos (becas)</th><th>Abre (becas)</th></tr>` +
+            base.porArea
+              .map((x, i) => {
+                const y = (becas.porArea || [])[i] || x;
+                return `<tr><td>${esc(x.area)}</td><td>${num(x.participacion * 100, 0)} %</td><td>${num(x.media, 0)}</td><td>${num(x.probApertura * 100, 0)} %</td><td>${num(y.media, 0)}</td><td>${num(y.probApertura * 100, 0)} %</td></tr>`;
+              })
+              .join("") +
+            "</table></div>",
+          nota: "Un área con poca participación rara vez reúne el mínimo por sí sola: conviene ofrecer pocos programas o módulos comunes.",
+          ancho: true,
+          sinRelleno: true,
+        })
+      : "";
+
+  $("simres").innerHTML =
+    `<div class="escenarios">${indicador("base", "Escenario base", base)}${indicador("becas", "Con becas", becas)}</div>` +
+    columnas(
+      bloque({
+        titulo: "Distribución de inscritos",
+        meta: "5 000 simulaciones",
+        cuerpo: distSvg(base, becas, b.minimo),
+        nota: `${origen} Con becas, la probabilidad de alcanzar ${b.minimo} inscritos pasa de ${num(base.probApertura * 100, 0)} % a ${num(becas.probApertura * 100, 0)} %.${base.guardada ? " Guardada la comparación: escenario base y con becas." : ""}`,
+        ancho: true,
+      }),
+      porArea
+    );
+  if (guardar) await historial(ctx);
+}
+
+export async function simular(ctx, guardar = false) {
+  try {
+    await ejecutar(ctx, guardar);
+  } catch {
+    $("simres").innerHTML = '<p class="aviso">No se pudo calcular la simulación. Revise que el servidor esté activo e inténtelo de nuevo.</p>';
+  }
+}
+
+/**
+ * Últimas comparaciones guardadas del origen de datos actual. Cada vez que se guarda, el servidor registra juntos el
+ * escenario base y el escenario con becas (misma corrida): aquí se muestran como UNA fila para no parecer un duplicado.
+ */
+export async function historial(ctx) {
+  const h = $("hist");
+  try {
+    const r = await fetch("/api/simulaciones?datos=" + ctx.fuente);
+    if (!r.ok) throw new Error("historial");
+    const corridas = new Map(); // corrida -> filas del programa en general (una por escenario)
+    for (const x of (await r.json()).filter((x) => !x.area)) {
+      if (!corridas.has(x.corrida)) corridas.set(x.corrida, []);
+      corridas.get(x.corrida).push(x);
+    }
+    const pct = (x) => (x ? `${num(x.probApertura * 100, 0)} %` : "—");
+    h.innerHTML = corridas.size
+      ? columnas(
+          bloque({
+            titulo: "Simulaciones guardadas",
+            meta: `Cada guardado compara base y becas · últimas 10 de ${corridas.size}`,
+            cuerpo:
+              `<div class="scroll"><table class="tabla"><tr><th>Fecha</th><th>Titulados usados</th><th>Interés</th><th>Inscripción base → becas</th><th>Mínimo</th><th>Abre (base)</th><th>Abre (becas)</th></tr>` +
+              [...corridas.values()]
+                .slice(0, 10)
+                .map((es) => {
+                  const base = es.find((e) => e.escenario === "base") || es[0];
+                  const becas = es.find((e) => e.escenario === "becas");
+                  const insc = `${num(base.probInscribe * 100, 0)} %${becas ? ` → ${num(becas.probInscribe * 100, 0)} %` : ""}`;
+                  return `<tr><td>${esc(String(base.fecha).slice(0, 16).replace("T", " "))}</td><td>${base.nTitulados}</td><td>${num(base.probInteres * 100, 0)} %</td><td>${insc}</td><td>${base.minimo}</td><td>${pct(base)}</td><td>${pct(becas)}</td></tr>`;
+                })
+                .join("") +
+              "</table></div>",
+            nota: "Cada simulación guardada registra dos escenarios, el base y el que suma el aumento por becas, para poder compararlos; por eso aparecen juntos en una sola fila.",
+            pie: `<a class="btn" href="/api/export/simulaciones.csv?datos=${ctx.fuente}&sep=${encodeURIComponent(ctx.sep)}">Descargar todas (CSV)</a>`,
+            ancho: true,
+            sinRelleno: true,
+          })
+        )
+      : "";
+  } catch {
+    h.innerHTML = "";
+  }
+}
+
+/** Recalcula sin guardar y recarga el historial (cuando cambia el origen de datos). */
+export function resimular(ctx) {
+  simular(ctx, false);
+  historial(ctx);
+}
+
+export function iniciarSimulacion(ctx) {
+  $("sim").onsubmit = (e) => {
+    e.preventDefault();
+    simular(ctx, true);
+  };
+  $("pi").addEventListener("input", () => (interesEditado = true));
+}
diff --git a/Arcusur/app/classes/static/js/panel/util.js b/Arcusur/app/classes/static/js/panel/util.js
new file mode 100644
index 0000000..57a74ec
--- /dev/null
+++ b/Arcusur/app/classes/static/js/panel/util.js
@@ -0,0 +1,55 @@
+// Utilidades compartidas por todas las vistas del panel.
+
+export const $ = (id) => document.getElementById(id);
+
+/** Escapa texto antes de insertarlo en HTML (las respuestas las escribe el público). */
+export const esc = (s) =>
+  String(s ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]);
+
+/** Número con coma decimal. */
+export const num = (x, d = 1) => String(+(+x).toFixed(d)).replace(".", ",");
+
+/** Nombres cortos para opciones muy largas (el texto completo queda en el tooltip). */
+const CORTO = [
+  [/^actualmente me encuentro trabajando/i, "Trabaja en una organización"],
+  [/^actualmente no trabajo/i, "No trabaja"],
+  [/^actualmente dedico/i, "Emprendimiento propio (tiempo completo)"],
+  [/^financiado con recursos propios/i, "Recursos propios"],
+  [/^financiado parcialmente/i, "Beca parcial"],
+  [/^total financiamiento/i, "Beca total"],
+];
+export const corto = (s) => {
+  for (const [re, t] of CORTO) if (re.test(s)) return t;
+  return s;
+};
+
+/** Filas de una distribución ordenadas de mayor a menor. */
+export const orden = (d) => d.filas.slice().sort((a, b) => b.n - a.n);
+
+export const pTxt = (p) => (p < 0.0001 ? "p < 0,0001" : "p = " + num(p, 4));
+
+/**
+ * Criterios de decisión del equipo. Se cambian aquí y todo el panel se ajusta
+ * (tabla de decisiones, semáforos y requisitos de calidad).
+ */
+export const UMB = {
+  mayoria: 50,
+  concentracion: 70,
+  acuerdoBajo: 60,
+  acuerdoAlto: 80,
+  demandaAlta: 60,
+  empleabilidadMin: 70,
+  primerTrabajoLento: 40,
+  junior: 3,
+  nMin: 30,
+  margenMax: 10,
+};
+
+export const NOMBRE_FUENTE = {
+  reales: "datos reales",
+  demo: "datos de demostración",
+  todos: "datos reales y de demostración",
+};
+
+/** Etiqueta de estado con punto de color: ok = favorable, at = atender, mal = crítico, in = referencia. */
+export const estado = (nivel, texto) => `<span class="estado e-${nivel}"><i></i>${texto}</span>`;
diff --git a/Arcusur/app/classes/static/js/panel/vistas.js b/Arcusur/app/classes/static/js/panel/vistas.js
new file mode 100644
index 0000000..a7e1a4f
--- /dev/null
+++ b/Arcusur/app/classes/static/js/panel/vistas.js
@@ -0,0 +1,331 @@
+// Vistas del panel. Cada función recibe las estadísticas (s) y el contexto de datos (ctx = { fuente, sep }) y devuelve HTML.
+
+import { esc, num, orden, pTxt, UMB, estado } from "./util.js";
+import { TT, TE, ALCANCE, LT, FPL, VCL, PARES } from "./etiquetas.js";
+import {
+  bloque, indicadores, columnas, grupo, metaN, barras, histograma, likert, pares, heat, caja, ojiva, tablaFrec, tablaDesc, brecha,
+  NIV4, COL4, CL4, NIV3, COL3, CL3,
+} from "./graficos.js";
+import { lecDist, lecArea, lecAnios, lecLikert, lecCruce, veredicto } from "./lecturas.js";
+import { filasDecision, tablaDecisiones, prevE } from "./decisiones.js";
+
+const consulta = (ctx) => `datos=${ctx.fuente}&sep=${encodeURIComponent(ctx.sep)}`;
+const enlaceCsv = (ctx, ruta, archivo, texto) => `<a class="btn" href="/api/export/${ruta}?${consulta(ctx)}" download="${archivo}">${texto}</a>`;
+
+/** Bloque de barras para una pregunta de opción única o múltiple. */
+const dist = (d, titulos, k, { multiple = false, ancho = false, titulo } = {}) =>
+  bloque({ titulo: titulo ?? titulos[k], meta: metaN(d, ALCANCE[k]), cuerpo: barras(d), nota: k === "area" ? lecArea(d) : lecDist(d, multiple), ancho });
+
+/** Grupo plegable a partir de una lista de bloques. */
+const seccion = (titulo, bloques, { abierto = false, antes = "" } = {}) => grupo(titulo, bloques.length, antes + columnas(...bloques), abierto);
+
+const filtrar = (v) => v.filter(Boolean);
+
+// ---------------------------------------------------------------------------
+// Estado sin datos
+// ---------------------------------------------------------------------------
+export const sinDatos = (fuente) =>
+  `<div class="estado-vacio"><b>Sin respuestas ${fuente === "reales" ? "reales " : ""}registradas</b>` +
+  `<p>El panel se completa a medida que titulados y empleadores responden las encuestas.</p>` +
+  `<div class="admin"><a class="btn btn-primario" href="index.html">Abrir las encuestas</a><button type="button" class="btn" data-accion="demo">Cargar datos de demostración</button></div></div>`;
+
+// ---------------------------------------------------------------------------
+// Resumen ejecutivo
+// ---------------------------------------------------------------------------
+export function vResumen(s) {
+  const K = [];
+  if (s.nTitulados) {
+    K.push(
+      { valor: s.nTitulados, etiqueta: "Titulados encuestados" },
+      { valor: `${num(s.pctInteres * 100, 0)} %`, etiqueta: "Interesados en un posgrado" },
+      { valor: `${num(s.likertT.satisfaccion.media, 1)} <small>/ 4</small>`, etiqueta: "Satisfacción con la formación" },
+      { valor: num(s.anios.mediana), etiqueta: "Años de vida profesional", detalle: `Mediana · media ${num(s.anios.media)} ± ${num(s.anios.sd)}` }
+    );
+  }
+  if (s.nEmpleadores) K.push({ valor: s.nEmpleadores, etiqueta: "Empleadores encuestados" }, { valor: `${num(prevE(s), 0)} %`, etiqueta: "Prevé contratar Ingenieros de Sistemas" });
+
+  const decisiones = bloque({
+    titulo: "Decisiones recomendadas",
+    meta: `${s.nTitulados} titulados · ${s.nEmpleadores} empleadores`,
+    cuerpo: tablaDecisiones(filasDecision(s)),
+    ancho: true,
+    sinRelleno: true,
+  });
+  return indicadores(K) + columnas(decisiones) + contraste(s);
+}
+
+/** Titulados frente a empleadores: porcentaje de acuerdo en afirmaciones equivalentes. */
+function contraste(s) {
+  if (!s.nTitulados || !s.nEmpleadores) return "";
+  const p = PARES.filter(([, t, e]) => s.likertT[t] && s.likertE[e] && s.likertT[t].n > 0 && s.likertE[e].n > 0);
+  if (p.length < PARES.length) return "";
+  const A = p.map(([, t]) => s.likertT[t].acuerdo);
+  const B = p.map(([, , e]) => s.likertE[e].acuerdo);
+  const dif = p.map((_, i) => B[i] - A[i]);
+  const k = dif.map(Math.abs).indexOf(Math.max(...dif.map(Math.abs)));
+  const nota =
+    Math.abs(dif[k]) < 10
+      ? "Titulados y empleadores coinciden: las diferencias son menores de 10 puntos."
+      : `Mayor distancia en «${esc(p[k][0])}»: ${dif[k] < 0 ? "los empleadores lo valoran menos que los titulados" : "los empleadores lo valoran más que los titulados"} (${num(Math.abs(dif[k]), 0)} puntos).`;
+  return columnas(
+    bloque({
+      titulo: "Titulados frente a empleadores",
+      meta: "Porcentaje de acuerdo",
+      cuerpo: pares(p.map((r) => r[0]), A, B),
+      nota: nota + " Las escalas difieren (4 y 3 niveles): la comparación es referencial.",
+      ancho: true,
+    })
+  );
+}
+
+// ---------------------------------------------------------------------------
+// Titulados
+// ---------------------------------------------------------------------------
+export function vTitulados(s) {
+  const d = s.distT;
+  const a = s.anios;
+  const tot = s.junior + s.consolidado;
+  const items = Object.keys(LT).map((k) => ({ label: LT[k], l: s.likertT[k] }));
+  const D = (k, op) => dist(d[k], TT, k, op);
+
+  const perfil = seccion(
+    "Perfil profesional",
+    [
+      bloque({ titulo: "Años de vida profesional", meta: metaN(s.aniosHist), cuerpo: histograma(s.aniosHist), nota: lecAnios(a, s.junior, s.consolidado) }),
+      D("edad"),
+      D("genero"),
+    ],
+    {
+      abierto: true,
+      antes: indicadores([
+        { valor: num(a.media), etiqueta: "Años de vida profesional (media)", detalle: `Desviación estándar ${num(a.sd)}` },
+        { valor: num(a.mediana), etiqueta: "Mediana", detalle: `Mitad central: de ${num(a.q1)} a ${num(a.q3)}` },
+        { valor: `${num((s.junior * 100) / tot, 0)} %`, etiqueta: `Junior (hasta ${UMB.junior} años)`, detalle: `${s.junior} junior · ${s.consolidado} consolidados` },
+      ]),
+    }
+  );
+
+  const descriptiva = seccion("Estadística descriptiva de los años de vida profesional", [
+    bloque({ titulo: "Medidas descriptivas", meta: `n = ${a.n}`, cuerpo: tablaDesc(a), ancho: true, sinRelleno: true }),
+    bloque({ titulo: "Diagrama de caja", meta: `n = ${a.n}`, cuerpo: caja(a) }),
+    bloque({ titulo: "Ojiva", meta: metaN(s.aniosHist), cuerpo: ojiva(s) }),
+    bloque({ titulo: "Tabla de frecuencias", meta: metaN(s.aniosHist), cuerpo: tablaFrec(s), nota: "fi = frecuencia absoluta · hi = relativa · Fi y Hi = acumuladas.", ancho: true, sinRelleno: true }),
+  ]);
+
+  const insercion = seccion("Inserción laboral", [
+    D("situacion"), D("tiempoPrimerTrabajo"), D("sector"), D("rubro"), D("departamento"), D("remuneracion"),
+  ]);
+
+  const formacion = seccion("Formación continua", [D("area"), D("orgPosgrado"), D("nivelPosgrado"), D("financiamiento")], {
+    antes: indicadores([{ valor: `${num(s.pctInteres * 100, 0)} %`, etiqueta: "Interesados en un posgrado", detalle: "En áreas de Ingeniería en Sistemas" }]),
+  });
+
+  const valoracion = seccion("Valoración de la formación", [
+    bloque({ titulo: "Brechas de formación", meta: "Porcentaje de acuerdo (niveles 3 y 4 de 4)", cuerpo: brecha(items, UMB, estado), nota: `Brecha: menos de ${UMB.acuerdoBajo} %. Atender: entre ${UMB.acuerdoBajo} % y ${UMB.acuerdoAlto} %. Fortaleza: ${UMB.acuerdoAlto} % o más.`, ancho: true, sinRelleno: true }),
+    bloque({ titulo: "Grado de acuerdo por afirmación", meta: "Escala de 1 a 4 · media ± desviación", cuerpo: likert(items, NIV4, COL4, CL4), nota: lecLikert(items, "de acuerdo o totalmente de acuerdo"), ancho: true }),
+    D("utiles", { multiple: true }),
+    D("mejorar", { multiple: true }),
+    D("ventaja", { multiple: true }),
+    D("pocoUtiles", { multiple: true }),
+  ]);
+
+  return perfil + descriptiva + insercion + formacion + valoracion;
+}
+
+// ---------------------------------------------------------------------------
+// Empleadores
+// ---------------------------------------------------------------------------
+export function vEmpleadores(s) {
+  const d = s.distE;
+  const L = s.likertE;
+  const P = Object.keys(FPL).map((k) => ({ label: FPL[k], l: L[k] }));
+  const V = Object.keys(VCL).map((k) => ({ label: VCL[k], l: L[k] }));
+  const noSabe = Object.values(L).reduce((a, l) => a + l.noSabe, 0);
+  const total = Object.values(L).reduce((a, l) => a + l.n + l.noSabe, 0);
+  const D = (k, op) => dist(d[k], TE, k, op);
+  const meta = "Escala de 1 a 3 · «No sabe» excluido";
+
+  const perfil = seccion("Perfil de las organizaciones", [D("tipo"), D("tamano"), D("rubro")], { abierto: true });
+  const demanda = seccion("Demanda de profesionales", [D("proyeccion"), D("nivelFormacion"), D("medio"), D("contrato"), D("cargos", { multiple: true, ancho: true })], {
+    antes: indicadores([{ valor: `${num(prevE(s), 0)} %`, etiqueta: "Prevé contratar Ingenieros de Sistemas", detalle: "Con alta probabilidad o según su crecimiento" }]),
+  });
+  const valoracion = seccion("Valoración de la Carrera", [
+    bloque({ titulo: "Formación y perfil profesional", meta, cuerpo: likert(P, NIV3, COL3, CL3), nota: lecLikert(P, "de acuerdo total o parcial"), ancho: true }),
+    bloque({ titulo: "Relación de la Carrera con la organización", meta, cuerpo: likert(V, NIV3, COL3, CL3), nota: lecLikert(V, "de acuerdo total o parcial"), ancho: true }),
+  ]);
+  const nota = `<p class="vacio">«No sabe»: ${noSabe} de ${total} respuestas (${total ? num((noSabe * 100) / total, 0) : 0} %). Las preguntas abiertas se revisan en el CSV limpio de empleadores.</p>`;
+  return perfil + demanda + valoracion + nota;
+}
+
+// ---------------------------------------------------------------------------
+// Análisis estadístico
+// ---------------------------------------------------------------------------
+function ejemploUniformidad(d, titulo) {
+  const u = d.unif;
+  const fo = d.filas.map((f) => f.n);
+  const formula = fo.length <= 6 ? `[${fo.map((x) => `(${x} − ${num(u.fe, 2)})²`).join(" + ")}] / ${num(u.fe, 2)}` : "Σ (FO − FE)² / FE";
+  const conclusion = u.chi2 < u.critico ? `${num(u.chi2, 2)} &lt; ${num(u.critico, 2)}: <b>uniformidad</b>` : `${num(u.chi2, 2)} ≥ ${num(u.critico, 2)}: <b>no uniformidad</b>`;
+  return `Ejemplo con «${esc(titulo)}»: n = ${u.n}, k = ${u.k}, FE = ${u.n} / ${u.k} = ${num(u.fe, 2)}. χ² = ${formula} = <b>${num(u.chi2, 2)}</b>. Valor teórico (α = 0,05 y ${u.gl} gl) = <b>${num(u.critico, 2)}</b>. ${conclusion}.`;
+}
+
+export function vEstadistica(s, ctx) {
+  const cruces = Object.values(s.cruces || {});
+
+  // Uniformidad
+  const filasU = (mapa, titulos, etiqueta) => {
+    const f = Object.keys(titulos)
+      .filter((k) => mapa && mapa[k] && mapa[k].unif)
+      .map((k) => {
+        const u = mapa[k].unif;
+        return (
+          `<tr><td>${esc(titulos[k])}</td><td>${u.n}</td><td>${u.k}</td>` +
+          `<td class="${u.confiable ? "" : "bajo"}"${u.confiable ? "" : ' title="Con menos de 5 respuestas esperadas por categoría la prueba no es fiable"'}>${num(u.fe, 1)}${u.confiable ? "" : " *"}</td>` +
+          `<td>${num(u.chi2, 2)}</td><td>${u.gl}</td><td>${num(u.critico, 2)}</td><td>${estado(u.uniforme ? "ok" : "in", u.uniforme ? "Uniformidad" : "No uniformidad")}</td></tr>`
+        );
+      });
+    return f.length ? `<tr class="sep"><td colspan="8">${etiqueta}</td></tr>` + f.join("") : "";
+  };
+  const tablaU = filasU(s.distT, TT, "Titulados") + filasU(s.distE, TE, "Empleadores");
+  const ejemplo = (() => {
+    let alterno = "";
+    for (const [m, t] of [[s.distT, TT], [s.distE, TE]])
+      for (const k of Object.keys(t)) if (m && m[k] && m[k].unif) {
+        if (m[k].unif.confiable) return ejemploUniformidad(m[k], t[k]);
+        alterno = alterno || ejemploUniformidad(m[k], t[k]);
+      }
+    return alterno;
+  })();
+  const procedimiento =
+    `<details class="supuestos"><summary>Procedimiento de cálculo</summary><div class="formulas" style="margin-top:10px">` +
+    `<div><small>Estadístico</small>χ² = Σ (FOᵢ − FEᵢ)² / FEᵢ</div><div><small>Frecuencia esperada</small>FE = n / k</div><div><small>Grados de libertad</small>gl = k − 1</div></div>` +
+    `<ul><li>Si χ² es menor que el valor teórico (α = 5 % y k − 1 gl) hay <b>uniformidad</b>; si no, <b>no uniformidad</b>.</li></ul></details>`;
+  const uniformidad = tablaU
+    ? bloque({
+        titulo: "Uniformidad de las respuestas",
+        meta: "χ² de bondad de ajuste · α = 5 %",
+        cuerpo: `<div class="scroll"><table class="tabla"><tr><th>Pregunta</th><th>n</th><th>k</th><th>FE = n/k</th><th>χ²</th><th>gl</th><th>χ² crítico</th><th>Resultado</th></tr>${tablaU}</table></div>`,
+        nota: `El asterisco indica FE &lt; 5: prueba poco fiable.${procedimiento}`,
+        pie: enlaceCsv(ctx, "uniformidad.csv", "uniformidad.csv", "Exportar resultados (CSV)"),
+        ancho: true,
+        sinRelleno: true,
+      })
+    : bloque({ titulo: "Uniformidad de las respuestas", cuerpo: '<p class="vacio">Todavía no hay respuestas para calcular la uniformidad.</p>', ancho: true });
+
+  // Independencia
+  const resumen = cruces.length
+    ? bloque({
+        titulo: "Relaciones entre variables",
+        meta: "χ² de independencia · α = 5 %",
+        cuerpo:
+          `<div class="scroll"><table class="tabla"><tr><th>Cruce</th><th>n</th><th>χ²</th><th>gl</th><th>p</th><th>V</th><th>Resultado</th></tr>` +
+          cruces
+            .map((c) => {
+              const [nivel, texto] = veredicto(c);
+              return `<tr><td>${esc(c.titulo)}</td><td>${c.n}</td><td>${c.chi2 != null ? num(c.chi2, 2) : "–"}</td><td>${c.gl ?? "–"}</td><td>${c.p != null ? num(c.p, 4) : "–"}</td><td>${c.cramerV != null ? num(c.cramerV, 2) : "–"}</td><td>${estado(nivel, texto)}</td></tr>`;
+            })
+            .join("") +
+          "</table></div>",
+        nota: "«No concluyente»: más del 20 % de las celdas tiene frecuencia esperada menor a 5.",
+        ancho: true,
+        sinRelleno: true,
+      })
+    : "";
+  const detalle = cruces.map((c) => {
+    const [nivel, texto] = veredicto(c);
+    const est =
+      c.chi2 != null
+        ? `<div class="estad"><span>χ² = <b>${num(c.chi2, 2)}</b></span><span>gl = <b>${c.gl}</b></span><span><b>${pTxt(c.p)}</b></span><span>V de Cramér = <b>${num(c.cramerV, 2)}</b></span><span>Celdas con esperada &lt; 5: <b>${num(c.pctEsperadosBajos, 0)} %</b></span></div>`
+        : "";
+    const cautela = c.chi2 != null && !c.confiable ? `<p class="cautela"><b>Cautela.</b> ${esc(c.aviso)}</p>` : "";
+    return bloque({
+      titulo: esc(c.titulo),
+      meta: `n = ${c.n} · ${estado(nivel, texto)}`,
+      cuerpo: heat(c) + est + cautela,
+      nota: c.chi2 != null ? lecCruce(c) : "",
+      pie: enlaceCsv(ctx, `cruce/${esc(c.id)}.csv`, `cruce_${esc(c.id)}.csv`, "Exportar matriz (CSV)"),
+      ancho: true,
+    });
+  });
+
+  return columnas(uniformidad) + (cruces.length ? columnas(resumen) + columnas(...detalle) : "");
+}
+
+// ---------------------------------------------------------------------------
+// Calidad de datos
+// ---------------------------------------------------------------------------
+export function vDatos(s, ctx) {
+  const m = s.muestra;
+  const q = s.calidad;
+
+  const K = indicadores([
+    { valor: s.nTitulados, etiqueta: "Titulados encuestados", detalle: s.nTitulados ? `Margen de error referencial ± ${num(m.margenTitulados)} puntos` : "" },
+    { valor: s.nEmpleadores, etiqueta: "Empleadores encuestados", detalle: s.nEmpleadores ? `Margen de error referencial ± ${num(m.margenEmpleadores)} puntos` : "" },
+    { valor: m.empresas, etiqueta: "Empresas individualizadas", detalle: `Públicas: ${m.empresasPublicas} · Privadas: ${m.empresasPrivadas}` },
+    { valor: num(q.completitud, 1) + " %", etiqueta: "Datos completos", detalle: "Campos obligatorios con respuesta" },
+  ]);
+
+  const cumple = (ok) => estado(ok ? "ok" : "mal", ok ? "Cumple" : "No cumple");
+  const val = [
+    ["Respuestas duplicadas", q.duplicadosTitulados + q.duplicadosEmpleadores, "0", "Se repiten todas las respuestas de otra persona.", true],
+    ["Campos obligatorios vacíos", q.camposObligatoriosVacios, "0", "Distinto de 0 indica datos cargados por otra vía.", true],
+    ["Valores fuera de rango", q.fueraDeRango, "0", "Años fuera de 0 a 60 o escalas fuera de su rango.", true],
+    ["Años negativos", q.aniosNegativos, "0", "Un tiempo no puede ser negativo.", true],
+    ["Incoherencias (desempleo mayor que vida profesional)", q.incoherentes, "0", "Más años desempleado que años de ejercicio.", true],
+    ["Valores atípicos en años de vida profesional", q.atipicos, "Informativo", "Regla de Tukey: se revisa que sea real y se reporta.", false],
+    ["Variantes de escritura unificadas", q.categoriasUnificadas, "Informativo", "Mayúsculas, tildes y espacios agrupados en una categoría.", false],
+    ["Respuestas «Otro» especificadas", q.otrasEspecificadas, "Informativo", "Texto libre agrupado como «Otro (…)».", false],
+  ];
+  const validacion = bloque({
+    titulo: "Validación de los datos",
+    cuerpo: `<div class="scroll"><table class="tabla texto"><tr><th>Verificación</th><th>Resultado</th><th>Esperado</th><th>Estado</th><th>Detalle</th></tr>${val
+      .map((r) => `<tr><td>${r[0]}</td><td><b>${r[1]}</b></td><td>${r[2]}</td><td>${r[4] ? cumple(r[1] === 0) : estado("in", "Informativo")}</td><td>${r[3]}</td></tr>`)
+      .join("")}</table></div>`,
+    ancho: true,
+    sinRelleno: true,
+  });
+
+  const esPub = (e) => /^p[uú]blic/i.test(e.tipo);
+  const esPri = (e) => /^privad/i.test(e.tipo);
+  const porNombre = (a, b) => a.nombre.localeCompare(b.nombre, "es");
+  const lista = (titulo, l) => (l.length ? `<h4>${titulo} (${l.length})</h4><ul>${l.map((e) => `<li title="${esc(e.nombre)}">${esc(e.nombre)}</li>`).join("")}</ul>` : "");
+  const empresas = bloque({
+    titulo: "Empresas individualizadas",
+    meta: `${m.empresas} en total`,
+    cuerpo: m.listaEmpresas.length
+      ? `<div class="empresas">${lista("Públicas", m.listaEmpresas.filter(esPub).sort(porNombre))}${lista("Privadas", m.listaEmpresas.filter(esPri).sort(porNombre))}${lista("Sin clasificar", m.listaEmpresas.filter((e) => !esPub(e) && !esPri(e)).sort(porNombre))}</div>`
+      : '<p class="vacio">Todavía no hay empresas registradas.</p>',
+    ancho: true,
+  });
+
+  const archivos = [
+    ["titulados.csv", "Titulados (limpio)"], ["empleadores.csv", "Empleadores (limpio)"], ["titulados_crudo.csv", "Titulados (crudo)"],
+    ["empleadores_crudo.csv", "Empleadores (crudo)"], ["diccionario.csv", "Diccionario de datos"], ["uniformidad.csv", "Pruebas de uniformidad"], ["simulaciones.csv", "Simulaciones guardadas"],
+  ];
+  const exportacion = bloque({
+    titulo: "Exportación",
+    cuerpo: `<div class="descargas">${archivos.map(([f, t]) => enlaceCsv(ctx, f, f, t)).join("")}</div>`,
+    nota: "Los archivos limpios están listos para analizar; los crudos conservan lo que respondió cada persona. El CSV de titulados incluye correo y teléfono: no se debe publicar ni compartir.",
+    ancho: true,
+  });
+
+  const metodologia = bloque({
+    titulo: "Metodología de cálculo",
+    cuerpo:
+      `<details class="supuestos"><summary>Fórmulas</summary><div class="formulas" style="margin-top:10px">` +
+      `<div><small>Media</small>x̄ = Σxᵢ / n</div><div><small>Varianza muestral</small>s² = Σ(xᵢ − x̄)² / (n − 1)</div><div><small>Coeficiente de variación</small>CV = s / x̄ × 100</div>` +
+      `<div><small>Cuartiles y percentiles</small>Interpolación lineal (método R-7)</div><div><small>Atípicos (Tukey)</small>Fuera de [Q1 − 1,5·RIC ; Q3 + 1,5·RIC]</div>` +
+      `<div><small>Asimetría</small>Coeficiente de Fisher ajustado</div><div><small>χ² de independencia</small>Σ(O − E)² / E, gl = (f − 1)(c − 1); confiable si menos del 20 % de celdas tiene E &lt; 5</div>` +
+      `<div><small>V de Cramér</small>√(χ² / (n · min(f − 1, c − 1)))</div></div>` +
+      `</details>`,
+    ancho: true,
+  });
+
+  const admin = bloque({
+    titulo: "Datos de demostración",
+    meta: "Ficticios · no usar como datos de campo",
+    cuerpo: `<div class="admin"><p>Registros ficticios, identificados aparte de los datos de campo.</p><button type="button" class="btn" data-accion="demo">Cargar datos de demostración</button><button type="button" class="btn" data-accion="borrar">Borrar datos de demostración</button></div>`,
+    ancho: true,
+  });
+
+  return K + columnas(validacion) + columnas(empresas, exportacion, metodologia, admin);
+}
