diff --git a/Arcusur/app/classes/static/app.css b/Arcusur/app/classes/static/app.css
new file mode 100644
index 0000000..cf9e7c3
--- /dev/null
+++ b/Arcusur/app/classes/static/app.css
@@ -0,0 +1,228 @@
+/* Estilos del panel de análisis (dashboard.html). Misma paleta que la pantalla de encuestas. */
+:root{--ink:#14202e;--teal:#0f766e;--teal2:#7fc4bc;--bg:#eef2f5;--line:#d5dce4;--soft:#e3f2f0;--mut:#52606f;--amber:#b45309;--amber-soft:#fdf1e3;
+/* Medidas comunes: todo control mide lo mismo, toda tarjeta tiene el mismo radio y relleno */
+--ctl:40px;--r:12px;--r-s:10px;--pad:18px;--ctl-line:#9aa6b5;--teal-line:#9bd0c9;--amber-line:#f0cfa3;--amber-ink:#7a3a07;--track:#edf1f5;--shadow:0 1px 6px rgba(20,32,46,.05)}
+*{box-sizing:border-box}
+body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.55 "Segoe UI",system-ui,sans-serif}
+a{color:var(--teal)}
+[hidden]{display:none!important}
+
+/* Encabezado y navegación por secciones (queda fija al desplazarse) */
+header{background:var(--ink);color:#fff;padding:14px 20px;display:flex;gap:24px;align-items:center;flex-wrap:wrap}
+header h1{font-size:18px;margin:0;font-weight:600;margin-right:auto}
+header a{color:#cfe8e5;text-decoration:none}header a:hover{text-decoration:underline}
+.tabs{position:sticky;top:0;z-index:5;display:flex;gap:4px;padding:0 16px;overflow-x:auto;background:rgba(238,242,245,.96);backdrop-filter:blur(6px);border-bottom:1px solid var(--line)}
+.tabs button{flex:none;height:auto;background:none;color:var(--mut);border:0;border-bottom:3px solid transparent;border-radius:0;padding:13px 14px 10px;font-weight:600;font-size:15px}
+.tabs button:hover{color:var(--ink)}
+.tabs button[aria-selected=true]{color:var(--teal);border-bottom-color:var(--teal)}
+main{max-width:1080px;margin:0 auto;padding:8px 16px 72px}
+
+/* Origen de los datos */
+.controls{display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin:22px 0 4px}
+.controls #demo{margin-left:auto}
+.seg-ctl{display:inline-flex;border:1px solid var(--ctl-line);border-radius:var(--r-s);overflow:hidden;background:#fff}
+.seg-ctl button{border:0;border-radius:0;background:#fff;color:var(--ink)}
+.seg-ctl button+button{border-left:1px solid var(--ctl-line)}
+.seg-ctl button[aria-pressed=true]{background:var(--ink);color:#fff}
+details.desc,details.grupo{margin-top:8px;background:#fff;border:1px solid var(--line);border-radius:var(--r);padding:10px 14px}
+details.desc summary,details.grupo>summary{cursor:pointer;font-weight:600}
+.dl{display:flex;flex-wrap:wrap;gap:10px;margin:12px 0 4px}
+.dl a{min-width:140px}
+.dl.dl-grid{display:grid;grid-template-columns:repeat(auto-fill,210px);justify-content:start}
+.dl.dl-grid a{width:210px}
+.dl a:hover,button.sec-b:hover{border-color:var(--teal);background:var(--soft)}
+.aviso{margin:14px 0 0;padding:10px 14px;border-radius:var(--r-s);background:var(--amber-soft);border:1px solid var(--amber-line);color:var(--amber-ink);font-weight:600}
+.vacio-grande{margin:30px 0;padding:34px;text-align:center;border:2px dashed var(--line);border-radius:var(--r);color:var(--mut);background:#fff}
+.vacio-grande b{display:block;font-size:19px;color:var(--ink);margin-bottom:6px}
+
+/* Secciones: etiqueta superior con la categoría de cada bloque */
+.panel{padding-top:8px}
+.panel[hidden]{display:none}
+.sec{margin:26px 0 0}
+.sec .eyebrow{margin:0;font-size:12.5px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--teal)}
+.sec h2{font-size:24px;line-height:1.25;margin:2px 0 6px;letter-spacing:-.01em}
+.sec .lead{margin:0 0 18px;color:var(--mut);max-width:780px}
+.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,430px),1fr));gap:16px;margin-bottom:16px;align-items:stretch}
+.grid:not(.kpis)>.card:last-child:nth-child(odd){grid-column:1/-1}
+.grid.kpis{grid-template-columns:repeat(auto-fit,minmax(min(100%,210px),1fr))}
+
+/* Indicadores */
+.k{background:#fff;border:1px solid var(--line);border-radius:var(--r);padding:14px var(--pad);box-shadow:var(--shadow)}
+.k b{display:block;font-size:30px;line-height:1.15;letter-spacing:-.02em}
+.k b small{font-size:15px;font-weight:600;color:var(--mut);letter-spacing:0}
+.k span{display:block;font-size:14px;font-weight:600}
+.k em{display:block;margin-top:4px;font-style:normal;font-size:13px;color:var(--mut)}
+.k.ok{border-color:var(--teal-line);background:var(--soft)}.k.falta{border-color:var(--amber-line);background:var(--amber-soft)}
+
+/* Tarjeta de gráfico: título, cómo leerlo, gráfico y lectura */
+.card{display:flex;flex-direction:column;background:#fff;border:1px solid var(--line);border-radius:var(--r);padding:var(--pad) 20px;box-shadow:var(--shadow)}
+.card h3{font-size:17px;line-height:1.3;margin:0 0 2px}
+.card .sub{margin:0 0 14px;font-size:13.5px;color:var(--mut)}
+.card .lectura{margin:16px 0 0;padding:10px 12px;border-left:4px solid var(--teal);background:var(--soft);border-radius:0 8px 8px 0;font-size:14.5px}
+.card .lectura b{color:var(--teal)}
+.card.ancho{grid-column:1/-1}
+.vacio{color:var(--mut);font-style:italic}
+
+/* Barras horizontales: etiqueta | barra | porcentaje y cantidad */
+.bars{display:grid;gap:7px}
+.bar{display:grid;grid-template-columns:minmax(110px,min(40%,260px)) 1fr 96px;gap:10px;align-items:center;font-size:14px}
+.bar .l{line-height:1.3;overflow-wrap:anywhere}
+.bar .t{height:22px;background:var(--track);border-radius:6px;overflow:hidden}
+.bar .t i{display:block;height:100%;background:var(--teal2);border-radius:6px}
+.bar.top .t i{background:var(--teal)}
+.bar .v{display:grid;grid-template-columns:56px 32px;column-gap:8px;justify-content:end;font-variant-numeric:tabular-nums;white-space:nowrap}
+.bar .v b{text-align:right}
+.bar .v small{text-align:right;color:var(--mut);font-size:12.5px}
+@media(max-width:560px){.bar{grid-template-columns:1fr 96px}.bar .l{grid-column:1/-1;margin-bottom:-3px}}
+
+/* Histograma */
+.hist{display:flex;gap:10px;height:210px;align-items:stretch}
+.hist .col{flex:1;display:grid;grid-template-rows:1fr auto;min-width:0}
+.hist .bw{display:flex;flex-direction:column;justify-content:flex-end;align-items:center;gap:3px}
+.hist .bw i{width:100%;border-radius:6px 6px 0 0;background:var(--teal)}
+.hist .bw i.jr{background:var(--teal2)}
+.hist .hv{font-size:12.5px;font-variant-numeric:tabular-nums}
+.hist .hl{padding-top:6px;border-top:1px solid var(--line);font-size:12.5px;line-height:1.25;text-align:center;color:var(--mut)}
+.leyenda{display:flex;flex-wrap:wrap;gap:6px 16px;margin:0 0 12px;font-size:13px;color:var(--mut)}
+.leyenda span{display:inline-flex;align-items:center;gap:6px}
+.leyenda i{width:12px;height:12px;border-radius:3px;display:inline-block}
+
+/* Escalas Likert: barra apilada al 100 % por afirmación */
+.lk{margin:0 0 14px}
+.lkt{display:flex;justify-content:space-between;gap:12px;align-items:baseline;font-size:14px;line-height:1.3;margin-bottom:4px}
+.lkt b{white-space:nowrap;font-variant-numeric:tabular-nums;min-width:92px;text-align:right}
+.lkt b small{font-weight:400;color:var(--mut)}
+.lkt .ns{color:var(--mut);font-size:12.5px;white-space:nowrap}
+.lk .seg{display:flex;height:22px;border-radius:6px;overflow:hidden;background:var(--track)}
+.lk .seg span{display:flex;align-items:center;justify-content:center;font-size:12.5px;font-weight:600;color:#fff;min-width:0;overflow:hidden}
+.lk .seg span.cl{color:var(--ink)}
+
+/* Radar (SVG) */
+svg.radar{width:100%;height:auto;max-width:520px;display:block;margin:0 auto}
+svg.radar text{font:12px "Segoe UI",system-ui,sans-serif;fill:var(--ink)}
+svg.radar .anillo{fill:none;stroke:var(--line)}svg.radar .eje{stroke:var(--line)}
+svg.radar .area{fill:rgba(15,118,110,.22);stroke:var(--teal);stroke-width:2}
+svg.radar circle{fill:var(--teal)}
+svg.radar .esc{fill:var(--mut);font-size:10.5px}
+
+/* Mapa de calor de los cruces */
+.scroll{overflow-x:auto}
+table.heat{border-collapse:separate;border-spacing:3px;width:100%;font-size:14px}
+table.heat th{padding:6px 8px;font-size:13.5px;font-weight:700;text-align:center;line-height:1.25;color:var(--mut)}
+table.heat th.f{text-align:left;max-width:230px;font-size:14px;font-weight:600;color:var(--ink)}
+table.heat td{padding:8px 6px;text-align:center;border-radius:var(--r-s);min-width:78px;height:54px;font-variant-numeric:tabular-nums}
+table.heat td b{display:block;font-size:17px;line-height:1.15}
+table.heat td small{font-size:12px;opacity:.85}
+table.heat td.sig{box-shadow:inset 0 0 0 2px var(--ink)}
+table.heat td.tot,table.heat th.tot{background:#f4f6f8;color:var(--mut);font-weight:600}
+.leyenda-heat{display:flex;flex-wrap:wrap;gap:6px 16px;margin:10px 0 0;font-size:12.5px;color:var(--mut)}
+.leyenda-heat span{display:inline-flex;align-items:center;gap:6px}
+.leyenda-heat i{width:14px;height:14px;border-radius:4px;display:inline-block}
+.estad{display:flex;flex-wrap:wrap;gap:6px 18px;margin:12px 0 0;font-size:14px;font-variant-numeric:tabular-nums}
+.estad b{font-weight:700}
+.cautela{margin:12px 0 0;padding:9px 12px;border-radius:var(--r-s);background:var(--amber-soft);border:1px solid var(--amber-line);color:var(--amber-ink);font-size:14px}
+.card .acciones{margin-top:16px}
+
+/* Etiquetas de empresas y tabla de calidad */
+.chips{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px}
+.chip,.ins{display:inline-flex;align-items:center;height:26px;padding:0 11px;border-radius:99px;font-size:13px;line-height:1;white-space:nowrap}
+.chip{border:1px solid var(--line);background:#fff}
+.chip.pub{border-color:var(--teal-line);background:var(--soft)}.chip.pri{border-color:var(--amber-line);background:var(--amber-soft)}
+
+/* Simulador */
+form.sim{background:#fff;border:1px solid var(--line);border-radius:var(--r);padding:var(--pad) 20px;display:grid;gap:14px;box-shadow:var(--shadow)}
+form.sim .campos{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:4px 14px}
+form.sim .campos label{display:grid;grid-template-rows:subgrid;grid-row:span 3;align-content:start;row-gap:0}
+form.sim .campos label small{min-height:1.4em;margin-top:4px}
+label{display:grid;gap:4px;font-weight:600;font-size:14px}
+label small{font-weight:400;color:var(--mut)}
+select,input{font:inherit;height:var(--ctl);padding:0 10px;border:1px solid var(--ctl-line);border-radius:var(--r-s);background:#fff;color:var(--ink);width:100%}
+input:focus-visible,button:focus-visible,a:focus-visible,summary:focus-visible{outline:3px solid var(--teal);outline-offset:2px}
+/* Botones y enlaces-botón: misma altura, radio y tipografía */
+button,.dl a{display:inline-flex;align-items:center;justify-content:center;height:var(--ctl);padding:0 16px;font:inherit;font-size:14.5px;font-weight:600;line-height:1;border-radius:var(--r-s);cursor:pointer;text-decoration:none;white-space:nowrap}
+button{background:var(--teal);color:#fff;border:0}
+button.sec-b,.dl a{background:#fff;color:var(--ink);border:1px solid var(--ctl-line)}
+.row{display:flex;gap:8px;flex-wrap:wrap}
+.esc2{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:14px;margin-top:16px}
+.esc2 .k b{font-size:30px}
+svg.dist{width:100%;height:auto;display:block}
+svg.dist text{font:12px "Segoe UI",system-ui,sans-serif;fill:var(--mut)}
+@media(prefers-reduced-motion:no-preference){button,.bar .t i,.hist .bw i{transition:background .15s,width .25s,height .25s}}
+
+/* Al imprimir se ocultan los controles */
+@media print{header,.controls,details.desc,.dl,.acciones,form.sim button{display:none!important}
+body{background:#fff}.card,.k{box-shadow:none;break-inside:avoid}.sec{break-before:auto}}
+
+/* Paneles: grupos plegables, hallazgos y tablas de resultados */
+details.grupo{margin:0 0 14px;padding:0;background:none;border:0}
+details.grupo>summary{list-style:none;display:flex;align-items:baseline;gap:10px;padding:10px 2px;border-bottom:2px solid var(--line);margin-bottom:14px;font-size:19px;letter-spacing:-.01em}
+details.grupo>summary::-webkit-details-marker{display:none}
+details.grupo>summary::before{content:"▾";color:var(--teal);font-size:15px}
+details.grupo:not([open])>summary::before{content:"▸"}
+details.grupo>summary small{font-size:13.5px;font-weight:400;color:var(--mut)}
+ul.hallazgos{list-style:none;margin:0;padding:0;display:grid;gap:10px}
+ul.hallazgos li{padding:10px 14px;border-left:4px solid var(--teal2);background:#f7f9fb;border-radius:0 8px 8px 0;font-size:15px}
+ul.hallazgos li b{display:block;font-size:12.5px;letter-spacing:.06em;text-transform:uppercase;color:var(--teal);margin-bottom:1px}
+table.res{border-collapse:collapse;width:100%;font-size:14.5px;font-variant-numeric:tabular-nums}
+table.res th{padding:8px 8px;text-align:right;font-size:13.5px;font-weight:700;color:var(--mut);border-bottom:2px solid var(--line);white-space:nowrap}
+table.res td{padding:9px 8px;border-bottom:1px solid var(--line);text-align:right;vertical-align:middle}
+table.res th:first-child,table.res td:first-child{text-align:left;white-space:normal}
+table.res tr.grp td{padding:14px 8px 6px;font-size:12.5px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--teal);border-bottom:2px solid var(--line);text-align:left}
+.ins{font-weight:700}
+.ins.si{background:var(--soft);color:#0b5a54}.ins.no{background:var(--track);color:var(--mut)}.ins.dud{background:var(--amber-soft);color:var(--amber-ink)}
+.nota-t{margin:10px 0 0;font-size:13.5px;color:var(--mut)}
+.pasos{margin:10px 0 0;padding-left:20px;font-size:14.5px}.pasos li{margin:3px 0}
+.formulas{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:10px;margin:10px 0}
+.formulas>div{padding:10px 14px;background:#f7f9fb;border-radius:8px;font-size:15px;white-space:nowrap;overflow-x:auto}
+.formulas small{display:block;font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--teal);margin-bottom:2px}
+.formula{margin:10px 0;padding:10px 14px;background:#f7f9fb;border-radius:8px;font-size:15px;overflow-x:auto;white-space:nowrap}
+@media print{.tabs{display:none!important}.panel[hidden]{display:block!important}}
+h2.ptit{font-size:26px;line-height:1.2;margin:18px 0 4px;letter-spacing:-.01em}
+.panel>.lead{margin:0 0 16px;color:var(--mut);max-width:780px}
+.sec h2{font-size:21px;margin:0 0 4px}
+.grid.one{grid-template-columns:1fr}
+
+/* Tabla de uniformidad: columnas alineadas */
+table.res td.fe{position:relative;padding-right:22px}
+table.res td.fe.bajo{color:var(--amber-ink);font-weight:700}
+table.res td.fe.bajo::after{content:"*";position:absolute;right:8px}
+table.res td.rs,table.res th:last-child{text-align:left}
+table.res td.rs .ins{display:inline-flex}
+/* Empresas agrupadas */
+.grupo-emp{margin-top:14px}.grupo-emp:first-child{margin-top:0}
+.grupo-emp h4{margin:0;font-size:12.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--mut)}
+.grupo-emp h4 span{margin-left:4px;padding:1px 7px;border-radius:99px;background:var(--track);font-size:12px}
+.grupo-emp .chips{margin-top:8px}
+
+/* Empresas: mosaico de celdas iguales y alineadas */
+.grupo-emp .chips{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:8px}
+.grupo-emp .chip{height:36px;padding:0 12px;border-radius:8px;justify-content:flex-start;gap:9px;overflow:hidden;font-size:14px}
+.grupo-emp .chip::before{content:"";flex:none;width:8px;height:8px;border-radius:50%;background:var(--mut)}
+.grupo-emp .chip.pub::before{background:var(--teal)}.grupo-emp .chip.pri::before{background:var(--amber)}
+.grupo-emp .chip{display:flex;white-space:nowrap;text-overflow:ellipsis}
+.grupo-emp{margin-top:18px}
+/* Ficha del método de simulación */
+.card.metodo{margin-bottom:16px}
+dl.ficha{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:10px;margin:0}
+dl.ficha>div{padding:10px 14px;background:#f7f9fb;border-radius:8px;border-left:4px solid var(--teal2)}
+dl.ficha dt{font-size:12.5px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--teal);margin-bottom:2px}
+dl.ficha dd{margin:0;font-size:14.5px}
+dl.ficha code{font-size:13px;background:var(--track);padding:1px 5px;border-radius:5px}
+
+/* ---- Decisiones, estados y gráficos nuevos ---- */
+.card .para{margin:-6px 0 12px;padding:8px 12px;border-radius:var(--r-s);background:#f7f9fb;border:1px dashed var(--line);font-size:13.5px;color:var(--mut)}
+.card .para b{color:var(--ink)}
+.est{display:inline-flex;align-items:center;height:24px;padding:0 10px;border-radius:99px;font-size:12.5px;font-weight:700;line-height:1;white-space:nowrap;border:1px solid transparent;margin-right:6px}
+.est-ok{background:var(--soft);border-color:var(--teal-line);color:#0b5a54}
+.est-at{background:var(--amber-soft);border-color:var(--amber-line);color:var(--amber-ink)}
+.est-mal{background:#fde8e8;border-color:#f0b4b4;color:#8a1c1c}
+table.res.txt th,table.res.txt td{text-align:left;vertical-align:top}
+table.res.txt td:first-child{min-width:140px}
+table.res.dec td{font-size:14px}
+table.res tr.tot td{border-top:2px solid var(--line);font-weight:700}
+table.res td small{display:block;color:var(--mut);font-size:12px}
+svg.caja,svg.ojiva{width:100%;height:auto;display:block;font-size:12px;fill:var(--ink)}
+svg.radar polygon.area2{fill:rgba(180,83,9,.16);stroke:var(--amber);stroke-width:2}
+svg.radar circle.area2{fill:var(--amber)}
+svg.radar circle.area{fill:var(--teal)}
+.est-in{background:var(--track);border-color:var(--line);color:var(--mut)}
diff --git a/Arcusur/app/classes/static/css/base.css b/Arcusur/app/classes/static/css/base.css
new file mode 100644
index 0000000..5a6c97e
--- /dev/null
+++ b/Arcusur/app/classes/static/css/base.css
@@ -0,0 +1,88 @@
+/* Base compartida: variables de diseño, tipografía, botones y campos de formulario. */
+:root {
+  --tinta: #1c2733;
+  --pizarra: #5b6775;
+  --papel: #f3f5f7;
+  --superficie: #ffffff;
+  --linea: #dde2e8;
+  --linea-fuerte: #b9c1cb;
+
+  --acento: #1f4d7a;
+  --acento-2: #3d73a8;
+  --acento-3: #a9c2dc;
+  --acento-suave: #e9eff6;
+
+  --verde: #2c6a4c;
+  --verde-suave: #e7f2ec;
+  --verde-linea: #b4d5c3;
+  --ambar: #9a5b00;
+  --ambar-suave: #fbf1de;
+  --ambar-linea: #e7cc9a;
+  --rojo: #a12b2b;
+  --rojo-suave: #fbeaea;
+  --rojo-linea: #e6b9b9;
+
+  --ctl: 40px;
+  --r: 6px;
+  --fuente: "Segoe UI Variable Text", "Segoe UI", system-ui, -apple-system, "Helvetica Neue", Arial, sans-serif;
+}
+
+*,
+*::before,
+*::after { box-sizing: border-box; }
+
+body {
+  margin: 0;
+  background: var(--papel);
+  color: var(--tinta);
+  font: 15px/1.5 var(--fuente);
+  font-variant-numeric: tabular-nums;
+}
+
+a { color: var(--acento); }
+[hidden] { display: none !important; }
+
+:focus-visible { outline: 3px solid var(--acento-2); outline-offset: 2px; }
+
+/* Botones */
+.btn {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 8px;
+  min-height: var(--ctl);
+  padding: 0 16px;
+  font: inherit;
+  font-weight: 600;
+  line-height: 1;
+  color: var(--tinta);
+  background: var(--superficie);
+  border: 1px solid var(--linea-fuerte);
+  border-radius: var(--r);
+  text-decoration: none;
+  white-space: nowrap;
+  cursor: pointer;
+}
+.btn:hover { border-color: var(--acento); background: var(--acento-suave); }
+.btn-primario { color: #fff; background: var(--acento); border-color: var(--acento); }
+.btn-primario:hover { background: #17405f; border-color: #17405f; }
+.btn:disabled { opacity: 0.55; cursor: default; }
+
+/* Campos */
+input,
+select,
+textarea {
+  width: 100%;
+  font: inherit;
+  color: var(--tinta);
+  background: var(--superficie);
+  border: 1px solid var(--linea-fuerte);
+  border-radius: var(--r);
+}
+input:not([type="radio"]):not([type="checkbox"]),
+select { height: var(--ctl); padding: 0 12px; }
+textarea { padding: 10px 12px; resize: vertical; }
+
+@media (prefers-reduced-motion: no-preference) {
+  .btn { transition: background 0.15s, border-color 0.15s; }
+}
diff --git a/Arcusur/app/classes/static/css/encuesta.css b/Arcusur/app/classes/static/css/encuesta.css
new file mode 100644
index 0000000..d7a57bb
--- /dev/null
+++ b/Arcusur/app/classes/static/css/encuesta.css
@@ -0,0 +1,79 @@
+/* Encuesta pública (index.html). Usa las variables de base.css. */
+body { font-size: 17px; line-height: 1.55; }
+
+.top { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px 20px; padding: 14px 20px; color: #fff; background: #15212d; }
+.top a { color: #c3cfdb; font-size: 15px; text-decoration: none; }
+.top a:hover { color: #fff; }
+.top nav { display: flex; gap: 20px; }
+
+main { max-width: 700px; margin: 28px auto 60px; padding: 0 14px; }
+.hoja { padding: 28px; background: var(--superficie); border: 1px solid var(--linea); border-radius: var(--r); }
+h1 { margin: 0 0 10px; font-size: 26px; line-height: 1.25; letter-spacing: -0.01em; }
+p { margin: 0 0 16px; color: var(--pizarra); }
+
+/* Elección de encuesta */
+.choose { display: grid; gap: 12px; margin-top: 20px; }
+.choose button {
+  display: grid; gap: 2px; padding: 16px 20px; font: inherit; font-size: 18px; font-weight: 600; text-align: left;
+  color: var(--tinta); background: var(--superficie); border: 1px solid var(--linea-fuerte); border-radius: var(--r); cursor: pointer;
+}
+.choose button span { font-size: 15px; font-weight: 400; color: var(--pizarra); }
+.choose button:hover { border-color: var(--acento); background: var(--acento-suave); }
+
+/* Progreso */
+.prog { height: 6px; overflow: hidden; background: var(--linea); border-radius: 6px; }
+#bar { width: 0; height: 100%; background: var(--acento); }
+.paso { margin: 10px 0 22px; font-size: 15px; font-weight: 600; color: var(--acento); }
+.desc { margin: 0 0 24px; font-size: 15px; }
+
+/* Preguntas */
+fieldset { margin: 0 0 26px; padding: 0; border: 0; }
+legend { margin-bottom: 12px; padding: 0; font-size: 18px; font-weight: 600; line-height: 1.35; }
+
+/* Opciones de respuesta */
+.opts { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 10px; align-items: stretch; }
+.opts.long { grid-template-columns: 1fr; }
+.opts.c4 { grid-template-columns: repeat(4, 1fr); }
+label { position: relative; display: block; }
+.opts label { display: flex; }
+.opts span { display: flex; align-items: center; width: 100%; min-height: 52px; padding: 12px 16px; line-height: 1.35; background: var(--superficie); border: 1px solid var(--linea-fuerte); border-radius: var(--r); }
+.opts.c4 span { justify-content: center; padding: 12px 8px; font-size: 15px; text-align: center; }
+.opts label:hover span { border-color: var(--acento); }
+.opts input:checked + span { font-weight: 600; background: var(--acento-suave); border-color: var(--acento); box-shadow: inset 0 0 0 1px var(--acento); }
+input[type="radio"], input[type="checkbox"] { position: absolute; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: pointer; }
+input[type="radio"]:focus-visible + span, input[type="checkbox"]:focus-visible + span { outline: 3px solid var(--acento-2); outline-offset: 2px; }
+input[type="checkbox"]:disabled + span { opacity: 0.45; }
+@media (max-width: 560px) { .opts.c4 { grid-template-columns: repeat(2, 1fr); } }
+
+/* Campos de texto */
+input:not([type="radio"]):not([type="checkbox"]), select { height: 52px; border-width: 1px; }
+fieldset input[name$="_otro"], fieldset input[name$="_otra"] { margin-top: 10px; }
+.cnt { margin: 8px 0 0; font-size: 14px; font-weight: 600; color: var(--acento); }
+
+/* Error y navegación */
+#err { min-height: 24px; margin: 0 0 12px; font-weight: 600; color: var(--rojo); }
+.nav, .fin-nav { display: flex; flex-wrap: wrap; gap: 12px; }
+.nav { justify-content: space-between; }
+.fin-nav { margin-top: 20px; }
+.nav .btn, .fin-nav .btn { min-height: 52px; padding: 0 26px; }
+#sig { margin-left: auto; }
+
+@media (max-width: 480px) { .hoja { padding: 20px; } h1 { font-size: 23px; } }
+@media (prefers-reduced-motion: no-preference) { #bar { transition: width 0.3s; } }
+
+/* Revisión antes de guardar y ficha de lo guardado */
+.registro-nombre { display: grid; gap: 2px; margin: 4px 0 22px; padding: 16px 18px; background: var(--acento-suave); border: 1px solid var(--acento-3); border-left: 4px solid var(--acento); border-radius: var(--r); }
+.registro-nombre small { font-size: 13px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--acento); }
+.registro-nombre strong { font-size: 20px; line-height: 1.3; overflow-wrap: anywhere; }
+.registro-nombre span { font-size: 14px; color: var(--pizarra); }
+.rev-resp { margin: 0 0 22px; border: 1px solid var(--linea); border-radius: var(--r); }
+.rev-resp summary { padding: 12px 16px; font-weight: 600; cursor: pointer; }
+#rev-lista { max-height: 420px; margin: 0; padding: 0 16px 14px; overflow: auto; border-top: 1px solid var(--linea); }
+#rev-lista dt { margin-top: 14px; font-size: 14px; line-height: 1.4; color: var(--pizarra); }
+#rev-lista dd { margin: 2px 0 0; font-weight: 600; overflow-wrap: anywhere; }
+#rev-err { min-height: 24px; margin: 0 0 12px; font-weight: 600; color: var(--rojo); }
+#rev-ok { margin-left: auto; }
+.ficha { display: grid; grid-template-columns: max-content 1fr; gap: 8px 20px; margin: 18px 0 0; padding: 16px 18px; background: #f8f9fb; border: 1px solid var(--linea); border-radius: var(--r); }
+.ficha dt { font-size: 15px; color: var(--pizarra); }
+.ficha dd { margin: 0; font-weight: 600; overflow-wrap: anywhere; }
+@media (max-width: 480px) { .ficha { grid-template-columns: 1fr; gap: 2px; } .ficha dd { margin-bottom: 10px; } }
diff --git a/Arcusur/app/classes/static/css/panel.css b/Arcusur/app/classes/static/css/panel.css
new file mode 100644
index 0000000..6d7864b
--- /dev/null
+++ b/Arcusur/app/classes/static/css/panel.css
@@ -0,0 +1,363 @@
+/* Panel de análisis: estructura (menú lateral + contenido) y componentes de datos. */
+
+/* ---------- Estructura ---------- */
+.app { display: grid; grid-template-columns: 240px minmax(0, 1fr); min-height: 100vh; }
+
+.lateral {
+  position: sticky;
+  top: 0;
+  align-self: start;
+  height: 100vh;
+  display: flex;
+  flex-direction: column;
+  gap: 24px;
+  padding: 22px 16px;
+  color: #d6dee8;
+  background: #15212d;
+}
+.marca strong { display: block; font-size: 17px; letter-spacing: 0.02em; color: #fff; }
+.marca span { display: block; margin-top: 2px; font-size: 13px; line-height: 1.35; color: #9fb0c2; }
+
+.menu { display: flex; flex-direction: column; gap: 2px; }
+.menu button {
+  display: flex;
+  align-items: center;
+  min-height: 38px;
+  padding: 0 12px;
+  font: inherit;
+  font-size: 14.5px;
+  text-align: left;
+  color: #c3cfdb;
+  background: none;
+  border: 0;
+  border-left: 3px solid transparent;
+  border-radius: 0 var(--r) var(--r) 0;
+  cursor: pointer;
+}
+.menu button:hover { color: #fff; background: rgba(255, 255, 255, 0.06); }
+.menu button[aria-current="page"] { color: #fff; font-weight: 600; background: rgba(255, 255, 255, 0.1); border-left-color: #7fb0e0; }
+
+.origen { margin-top: auto; display: grid; gap: 8px; }
+.origen label { font-size: 13px; color: #9fb0c2; }
+.origen select { height: 36px; color: #fff; background: #1f2f3f; border-color: #3a4d60; }
+.origen a { font-size: 13.5px; color: #c3cfdb; }
+
+.contenido { padding: 24px 28px 72px; max-width: 1240px; width: 100%; }
+.cabecera { margin-bottom: 18px; }
+.cabecera h1 { margin: 0; font-size: 24px; line-height: 1.25; letter-spacing: -0.01em; }
+.cabecera p { margin: 2px 0 0; color: var(--pizarra); }
+
+.aviso {
+  margin: 0 0 16px;
+  padding: 10px 14px;
+  color: #6b3f00;
+  font-weight: 600;
+  background: var(--ambar-suave);
+  border: 1px solid var(--ambar-linea);
+  border-radius: var(--r);
+}
+
+@media (max-width: 880px) {
+  .app { grid-template-columns: 1fr; }
+  .lateral { position: static; height: auto; gap: 14px; padding: 14px 16px; }
+  .menu { flex-direction: row; overflow-x: auto; gap: 4px; }
+  .menu button { flex: none; border-left: 0; border-bottom: 3px solid transparent; border-radius: var(--r) var(--r) 0 0; }
+  .menu button[aria-current="page"] { border-bottom-color: #7fb0e0; }
+  .origen { margin-top: 0; grid-template-columns: auto 1fr; align-items: center; }
+  .contenido { padding: 18px 14px 56px; }
+}
+
+/* ---------- Bloques y cuadrículas ---------- */
+.cols {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr));
+  gap: 16px;
+  margin-bottom: 16px;
+}
+.bloque {
+  display: flex;
+  flex-direction: column;
+  min-width: 0;
+  background: var(--superficie);
+  border: 1px solid var(--linea);
+  border-radius: var(--r);
+}
+.bloque.ancho { grid-column: 1 / -1; }
+.bloque > header {
+  display: flex;
+  justify-content: space-between;
+  align-items: baseline;
+  gap: 12px;
+  padding: 12px 16px;
+  border-bottom: 1px solid var(--linea);
+}
+.bloque h3 { margin: 0; font-size: 15px; line-height: 1.3; }
+.bloque .meta { flex: none; font-size: 13px; color: var(--pizarra); }
+.bloque .cuerpo { flex: 1; padding: 14px 16px; }
+.bloque .cuerpo.sin-relleno { padding: 0; }
+.bloque .nota { margin: 0; padding: 10px 16px; font-size: 13.5px; color: var(--pizarra); border-top: 1px solid var(--linea); }
+.bloque .pie { display: flex; flex-wrap: wrap; gap: 8px; padding: 10px 16px; border-top: 1px solid var(--linea); }
+.vacio { margin: 0; color: var(--pizarra); }
+
+.cols + .grupo, .bloque + .grupo { margin-top: 8px; }
+
+/* Grupos plegables de una vista */
+details.grupo { margin-bottom: 18px; }
+details.grupo > summary {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  padding: 8px 0;
+  margin-bottom: 12px;
+  font-size: 17px;
+  font-weight: 600;
+  list-style: none;
+  border-bottom: 2px solid var(--tinta);
+  cursor: pointer;
+}
+details.grupo > summary::-webkit-details-marker { display: none; }
+details.grupo > summary::before {
+  content: "";
+  width: 7px;
+  height: 7px;
+  border-right: 2px solid var(--pizarra);
+  border-bottom: 2px solid var(--pizarra);
+  transform: rotate(-45deg);
+}
+details.grupo[open] > summary::before { transform: rotate(45deg); }
+details.grupo > summary small { margin-left: auto; font-size: 13px; font-weight: 400; color: var(--pizarra); }
+
+/* ---------- Indicadores ---------- */
+.indicadores {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(176px, 1fr));
+  gap: 1px;
+  margin-bottom: 16px;
+  overflow: hidden;
+  background: var(--linea);
+  border: 1px solid var(--linea);
+  border-radius: var(--r);
+}
+.ind { padding: 14px 16px; background: var(--superficie); }
+.ind b { display: block; font-size: 26px; line-height: 1.15; letter-spacing: -0.01em; }
+.ind b small { font-size: 14px; font-weight: 600; color: var(--pizarra); }
+.ind span { display: block; margin-top: 2px; font-size: 13.5px; font-weight: 600; }
+.ind em { display: block; margin-top: 2px; font-style: normal; font-size: 12.5px; color: var(--pizarra); }
+
+/* ---------- Tablas ---------- */
+.scroll { overflow-x: auto; }
+table.tabla { width: 100%; border-collapse: collapse; font-size: 14px; }
+table.tabla th {
+  padding: 9px 12px;
+  font-size: 13px;
+  font-weight: 600;
+  text-align: right;
+  color: var(--pizarra);
+  white-space: nowrap;
+  background: #f8f9fb;
+  border-bottom: 1px solid var(--linea-fuerte);
+}
+table.tabla td { padding: 9px 12px; text-align: right; vertical-align: top; border-bottom: 1px solid var(--linea); }
+table.tabla tr:last-child td { border-bottom: 0; }
+table.tabla th:first-child, table.tabla td:first-child { text-align: left; }
+table.tabla.texto th, table.tabla.texto td { text-align: left; }
+table.tabla small { display: block; font-size: 12px; color: var(--pizarra); }
+table.tabla tr.total td { font-weight: 700; border-top: 1px solid var(--linea-fuerte); }
+table.tabla tr.sep td { padding: 12px 12px 6px; font-size: 13px; font-weight: 600; color: var(--pizarra); background: #f8f9fb; text-align: left; }
+table.tabla td.bajo { color: var(--ambar); font-weight: 700; }
+table.decisiones td:first-child { min-width: 150px; font-weight: 600; }
+table.decisiones td:nth-child(3) { min-width: 150px; color: var(--pizarra); }
+table.decisiones td:nth-child(4) { white-space: nowrap; }
+
+.estado { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 600; white-space: nowrap; }
+.estado i { width: 9px; height: 9px; border-radius: 50%; background: var(--pizarra); }
+.e-ok { color: var(--verde); } .e-ok i { background: var(--verde); }
+.e-at { color: var(--ambar); } .e-at i { background: #c98a1b; }
+.e-mal { color: var(--rojo); } .e-mal i { background: var(--rojo); }
+.e-in { color: var(--pizarra); }
+
+/* ---------- Gráficos ---------- */
+.leyenda { display: flex; flex-wrap: wrap; gap: 6px 16px; margin: 0 0 12px; font-size: 13px; color: var(--pizarra); }
+.leyenda span { display: inline-flex; align-items: center; gap: 6px; }
+.leyenda i { width: 11px; height: 11px; border-radius: 2px; display: inline-block; }
+
+.bars { display: grid; gap: 8px; }
+.bar { display: grid; grid-template-columns: minmax(120px, min(38%, 260px)) 1fr 92px; gap: 12px; align-items: center; font-size: 14px; }
+.bar .l { line-height: 1.3; overflow-wrap: anywhere; }
+.bar .t { height: 14px; background: #edf0f4; border-radius: 3px; overflow: hidden; }
+.bar .t i { display: block; height: 100%; background: var(--acento-3); }
+.bar.top .t i { background: var(--acento); }
+.bar .v { display: grid; grid-template-columns: 54px 30px; column-gap: 8px; justify-content: end; white-space: nowrap; }
+.bar .v b { text-align: right; }
+.bar .v small { text-align: right; color: var(--pizarra); font-size: 12.5px; }
+@media (max-width: 560px) {
+  .bar { grid-template-columns: 1fr 92px; }
+  .bar .l { grid-column: 1 / -1; margin-bottom: -4px; }
+}
+
+.hist { display: flex; gap: 10px; height: 210px; align-items: stretch; }
+.hist .col { flex: 1; display: grid; grid-template-rows: 1fr auto; min-width: 0; }
+.hist .bw { display: flex; flex-direction: column; justify-content: flex-end; align-items: center; gap: 3px; }
+.hist .bw i { width: 100%; background: var(--acento); border-radius: 3px 3px 0 0; }
+.hist .bw i.jr { background: var(--acento-3); }
+.hist .hv { font-size: 12.5px; }
+.hist .hl { padding-top: 6px; font-size: 12.5px; line-height: 1.25; text-align: center; color: var(--pizarra); border-top: 1px solid var(--linea); }
+
+.lk { margin: 0 0 14px; }
+.lk:last-child { margin-bottom: 0; }
+.lkt { display: flex; justify-content: space-between; gap: 12px; align-items: baseline; margin-bottom: 4px; font-size: 14px; line-height: 1.3; }
+.lkt b { min-width: 92px; text-align: right; white-space: nowrap; }
+.lkt b small { font-weight: 400; color: var(--pizarra); }
+.lkt .ns { font-size: 12.5px; color: var(--pizarra); white-space: nowrap; }
+.lk .seg { display: flex; height: 22px; overflow: hidden; background: #edf0f4; border-radius: 3px; }
+.lk .seg span { display: flex; align-items: center; justify-content: center; min-width: 0; overflow: hidden; font-size: 12.5px; font-weight: 600; color: #fff; }
+.lk .seg span.cl { color: var(--tinta); }
+
+.par { margin: 0 0 14px; }
+.par:last-child { margin-bottom: 0; }
+.par > span { display: block; margin-bottom: 4px; font-size: 14px; }
+.par .fila { display: grid; grid-template-columns: 96px 1fr 48px; gap: 10px; align-items: center; margin-bottom: 3px; font-size: 13px; color: var(--pizarra); }
+.par .t { height: 12px; background: #edf0f4; border-radius: 3px; overflow: hidden; }
+.par .t i { display: block; height: 100%; }
+.par .fila b { text-align: right; color: var(--tinta); }
+
+svg.caja, svg.ojiva, svg.dist { display: block; width: 100%; height: auto; }
+svg text { font: 12px var(--fuente); fill: var(--pizarra); }
+svg.caja text, svg.dist .rotulo { fill: var(--tinta); }
+
+table.heat { width: 100%; border-collapse: separate; border-spacing: 3px; font-size: 14px; }
+table.heat th { padding: 6px 8px; font-size: 13px; font-weight: 600; text-align: center; line-height: 1.25; color: var(--pizarra); }
+table.heat th.f { max-width: 230px; text-align: left; color: var(--tinta); }
+table.heat td { min-width: 78px; height: 52px; padding: 6px; text-align: center; border-radius: 4px; }
+table.heat td b { display: block; font-size: 16px; line-height: 1.15; }
+table.heat td small { font-size: 12px; opacity: 0.85; }
+table.heat td.sig { box-shadow: inset 0 0 0 2px var(--tinta); }
+table.heat td.tot, table.heat th.tot { color: var(--pizarra); background: #f3f5f7; }
+.leyenda-heat { display: flex; flex-wrap: wrap; gap: 6px 16px; margin: 10px 0 0; font-size: 12.5px; color: var(--pizarra); }
+.leyenda-heat span { display: inline-flex; align-items: center; gap: 6px; }
+.leyenda-heat i { width: 14px; height: 14px; border-radius: 3px; display: inline-block; }
+.estad { display: flex; flex-wrap: wrap; gap: 6px 18px; margin: 12px 0 0; font-size: 14px; }
+.cautela { margin: 12px 0 0; padding: 9px 12px; font-size: 14px; color: #6b3f00; background: var(--ambar-suave); border: 1px solid var(--ambar-linea); border-radius: var(--r); }
+
+/* ---------- Simulación ---------- */
+.sim-layout { display: grid; grid-template-columns: minmax(260px, 320px) minmax(0, 1fr); gap: 16px; align-items: start; }
+@media (max-width: 980px) { .sim-layout { grid-template-columns: 1fr; } }
+form.sim { display: grid; gap: 14px; }
+form.sim label { display: grid; gap: 4px; font-size: 14px; font-weight: 600; }
+form.sim label small { min-height: 1.3em; font-weight: 400; color: var(--pizarra); }
+.escenarios { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1px; margin-bottom: 16px; overflow: hidden; background: var(--linea); border: 1px solid var(--linea); border-radius: var(--r); }
+.escenarios .ind b { font-size: 32px; }
+.escenarios .ind.base { border-top: 4px solid #c98a1b; }
+.escenarios .ind.becas { border-top: 4px solid var(--acento); }
+.supuestos { font-size: 14px; color: var(--pizarra); }
+.supuestos summary { cursor: pointer; font-weight: 600; color: var(--tinta); }
+.supuestos ul { margin: 8px 0 0; padding-left: 18px; }
+
+/* ---------- Calidad de datos y metodología ---------- */
+.empresas h4 { margin: 14px 0 8px; font-size: 13.5px; color: var(--pizarra); }
+.empresas h4:first-child { margin-top: 0; }
+.empresas ul { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 6px 14px; margin: 0; padding: 0; list-style: none; font-size: 14px; }
+.empresas li { padding: 4px 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; border-bottom: 1px solid var(--linea); }
+.formulas { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 10px; margin: 0; }
+.formulas > div { padding: 10px 12px; font-size: 14px; background: #f8f9fb; border: 1px solid var(--linea); border-radius: var(--r); overflow-x: auto; }
+.formulas small { display: block; margin-bottom: 2px; font-size: 12.5px; font-weight: 600; color: var(--pizarra); }
+.admin { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
+.admin p { flex: 1 1 320px; margin: 0; color: var(--pizarra); font-size: 14px; }
+.descargas { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 10px; }
+
+.estado-vacio { padding: 48px 24px; text-align: center; background: var(--superficie); border: 1px dashed var(--linea-fuerte); border-radius: var(--r); }
+.estado-vacio b { display: block; margin-bottom: 4px; font-size: 18px; }
+.estado-vacio p { margin: 0 0 16px; color: var(--pizarra); }
+.estado-vacio .admin { justify-content: center; }
+
+/* ---------- Administración de respuestas ---------- */
+.reg-barra { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px 16px; margin-bottom: 14px; }
+.tabs { display: inline-flex; gap: 2px; padding: 3px; background: #e4e9ee; border-radius: var(--r); }
+.tabs button {
+  display: inline-flex; align-items: center; gap: 8px; min-height: 34px; padding: 0 14px;
+  font: inherit; font-size: 14px; font-weight: 600; color: var(--pizarra); background: none; border: 0; border-radius: 4px; cursor: pointer;
+}
+.tabs button span { padding: 1px 7px; font-size: 12px; font-weight: 600; color: var(--pizarra); background: rgba(255, 255, 255, 0.7); border-radius: 10px; }
+.tabs button:hover { color: var(--tinta); }
+.tabs button[aria-selected="true"] { color: var(--tinta); background: var(--superficie); box-shadow: 0 1px 2px rgba(21, 33, 45, 0.18); }
+.tabs button[aria-selected="true"] span { color: var(--acento); background: var(--acento-suave); }
+.reg-herr { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
+.reg-herr input[type="search"] { width: 270px; max-width: 100%; }
+
+.reg-msg { margin: 0 0 14px; padding: 10px 14px; font-weight: 600; border: 1px solid; border-radius: var(--r); }
+.reg-msg.ok { color: var(--verde); background: var(--verde-suave); border-color: var(--verde-linea); }
+.reg-msg.mal { color: var(--rojo); background: var(--rojo-suave); border-color: var(--rojo-linea); }
+.reg-nota { margin: 12px 2px 0; font-size: 13.5px; color: var(--pizarra); }
+.reg-vacio { padding: 40px 16px; text-align: center; }
+
+table.tabla.reg td b { display: block; font-weight: 600; overflow-wrap: anywhere; }
+table.tabla.reg td { vertical-align: middle; }
+table.tabla.reg th.acc, table.tabla.reg td.acc { text-align: right; }
+table.tabla.reg td.acc div { display: inline-flex; gap: 6px; }
+table.tabla.reg tbody tr:hover td { background: #f8fafc; }
+.lin { display: block; white-space: nowrap; }
+.lin em { display: inline-block; min-width: 46px; margin-right: 6px; font-style: normal; font-size: 12.5px; color: var(--pizarra); }
+.pag { align-items: center; font-size: 13.5px; color: var(--pizarra); }
+.sp { flex: 1; }
+
+.btn-sm { min-height: 30px; padding: 0 11px; font-size: 13px; }
+.btn-peligro { color: var(--rojo); border-color: var(--rojo-linea); }
+.btn-peligro:hover { color: var(--rojo); background: var(--rojo-suave); border-color: var(--rojo); }
+.btn-peligro.solido { color: #fff; background: var(--rojo); border-color: var(--rojo); }
+.btn-peligro.solido:hover { background: #861f1f; border-color: #861f1f; }
+
+/* Diálogos */
+.dlg {
+  width: min(780px, calc(100vw - 24px)); max-height: calc(100vh - 32px); padding: 0; overflow: hidden;
+  color: var(--tinta); background: var(--superficie); border: 1px solid var(--linea-fuerte); border-radius: 8px;
+  box-shadow: 0 18px 50px rgba(21, 33, 45, 0.35);
+}
+.dlg.dlg-chico { width: min(420px, calc(100vw - 24px)); }
+.dlg::backdrop { background: rgba(21, 33, 45, 0.58); }
+.dlg[open] { display: flex; flex-direction: column; }
+.dlg-form { display: flex; flex-direction: column; min-height: 0; max-height: calc(100vh - 34px); }
+.dlg-cab { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; padding: 16px 20px 14px; border-bottom: 1px solid var(--linea); }
+.dlg-cab h2 { margin: 0; font-size: 18px; line-height: 1.3; overflow-wrap: anywhere; }
+.dlg-cab p { margin: 3px 0 0; font-size: 13.5px; color: var(--pizarra); overflow-wrap: anywhere; }
+.dlg-x { flex: none; width: 32px; height: 32px; font-size: 22px; line-height: 1; color: var(--pizarra); background: none; border: 0; border-radius: var(--r); cursor: pointer; }
+.dlg-x:hover { color: var(--tinta); background: var(--acento-suave); }
+.dlg-cuerpo { flex: 1; min-height: 0; padding: 6px 20px 18px; overflow: auto; }
+.dlg-pie { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; padding: 12px 20px; background: #f8f9fb; border-top: 1px solid var(--linea); }
+.dlg-nota { font-size: 13px; color: var(--pizarra); }
+.dlg-err { margin: 0; padding: 10px 20px; font-size: 14px; font-weight: 600; color: var(--rojo); white-space: pre-line; background: var(--rojo-suave); border-top: 1px solid var(--rojo-linea); }
+
+.det-grupo { margin-top: 18px; }
+.det-grupo h4 { margin: 0 0 6px; padding-bottom: 6px; font-size: 13px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--acento); border-bottom: 1px solid var(--linea); }
+dl.det { display: grid; grid-template-columns: minmax(150px, 34%) 1fr; gap: 0 18px; margin: 0; }
+dl.det dt, dl.det dd { padding: 8px 0; border-bottom: 1px solid var(--linea); }
+dl.det dt { font-size: 13.5px; color: var(--pizarra); }
+dl.det dd { margin: 0; font-weight: 600; overflow-wrap: anywhere; }
+dl.det dt:last-of-type, dl.det dd:last-of-type { border-bottom: 0; }
+.del-nombre { margin: 14px 0 8px; padding: 10px 14px; font-weight: 600; overflow-wrap: anywhere; background: var(--rojo-suave); border-left: 4px solid var(--rojo); border-radius: var(--r); }
+
+/* Formulario de edición */
+.cmp { display: grid; gap: 6px; margin-top: 14px; padding: 0; border: 0; }
+.cmp > label, .cmp > legend { display: grid; gap: 1px; padding: 0; }
+fieldset.cmp { min-width: 0; }
+fieldset.cmp legend { margin-bottom: 6px; }
+.cmp-t { font-size: 14px; font-weight: 600; }
+.cmp-t i { font-style: normal; color: var(--rojo); }
+.cmp-q { font-size: 12.5px; line-height: 1.4; color: var(--pizarra); }
+.cmp select { height: var(--ctl); padding: 0 8px; }
+.chk { display: grid; gap: 2px; padding: 6px 10px; border: 1px solid var(--linea-fuerte); border-radius: var(--r); }
+.chk label { display: flex; align-items: flex-start; gap: 8px; padding: 4px 0; font-size: 14px; line-height: 1.4; cursor: pointer; }
+.chk input { flex: none; width: 16px; height: 16px; margin: 2px 0 0; accent-color: var(--acento); }
+
+@media (max-width: 640px) {
+  dl.det { grid-template-columns: 1fr; }
+  dl.det dt { padding-bottom: 0; border-bottom: 0; }
+  .reg-herr input[type="search"] { width: 100%; }
+}
+
+@media print {
+  .lateral, .origen, .pie, .admin { display: none !important; }
+  .app { display: block; }
+  body { background: #fff; }
+  .vista[hidden] { display: block !important; }
+  .bloque, .ind { break-inside: avoid; }
+}
diff --git a/Arcusur/app/classes/static/dashboard.html b/Arcusur/app/classes/static/dashboard.html
new file mode 100644
index 0000000..a76e646
--- /dev/null
+++ b/Arcusur/app/classes/static/dashboard.html
@@ -0,0 +1,86 @@
+<!doctype html>
+<html lang="es">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width,initial-scale=1">
+  <title>ARCUSUR · Evaluación de la Carrera de Ingeniería de Sistemas</title>
+  <link rel="stylesheet" href="css/base.css">
+  <link rel="stylesheet" href="css/panel.css">
+</head>
+<body>
+<div class="app">
+  <aside class="lateral">
+    <div class="marca">
+      <strong>ARCUSUR</strong>
+      <span>Ingeniería de Sistemas · UMSS<br>Plan de Desarrollo Estratégico</span>
+    </div>
+    <nav class="menu" id="menu" aria-label="Secciones del panel"></nav>
+    <div class="origen">
+      <label for="origen">Origen de los datos</label>
+      <select id="origen">
+        <option value="reales">Datos reales</option>
+        <option value="demo">Demostración</option>
+        <option value="todos">Reales y demostración</option>
+      </select>
+      <a href="index.html">Ir a las encuestas</a>
+    </div>
+  </aside>
+
+  <main class="contenido">
+    <header class="cabecera">
+      <h1 id="titulo">Resumen ejecutivo</h1>
+      <p id="detalle"></p>
+    </header>
+    <p class="aviso" id="aviso" role="status" hidden></p>
+
+    <!-- Las vistas de datos se generan en js/panel/vistas.js -->
+    <div id="app"></div>
+
+    <!-- Simulación: vive en el HTML para conservar los parámetros al cambiar de vista -->
+    <section class="vista" id="v-simulacion" hidden>
+      <div class="sim-layout">
+        <section class="bloque">
+          <header><h3>Parámetros</h3></header>
+          <div class="cuerpo">
+            <form class="sim" id="sim">
+              <label>Titulados potenciales<input id="pob" type="number" value="300" min="1"></label>
+              <label>Probabilidad de interés<input id="pi" type="number" step="0.01" min="0" max="1" value="0.6"><small id="piHint"></small></label>
+              <label>Probabilidad de inscripción (base)<input id="pr" type="number" step="0.01" min="0" max="1" value="0.3"></label>
+              <label>Aumento por becas (puntos)<input id="bono" type="number" step="0.01" min="0" max="1" value="0.1"></label>
+              <label>Mínimo de inscritos para abrir<input id="mn" type="number" value="60" min="1"></label>
+              <button class="btn btn-primario">Simular y guardar comparación</button>
+            </form>
+          </div>
+          <div class="nota">
+            <details class="supuestos">
+              <summary>Supuestos del modelo</summary>
+              <ul>
+                <li>Cada titulado potencial se inscribe con probabilidad q = interés × inscripción; los inscritos siguen una distribución Binomial(n, q).</li>
+                <li>Se simulan 5 000 repeticiones por escenario. La probabilidad de abrir es la proporción de repeticiones que alcanza el mínimo.</li>
+                <li>El interés sale de las respuestas del origen de datos elegido; cada área recibe su participación entre quienes eligieron un área.</li>
+                <li>En el escenario con becas, el aumento se suma a la probabilidad de inscripción.</li>
+                <li>Al guardar se registra una comparación: el escenario base y el escenario con becas (dos escenarios por guardado).</li>
+              </ul>
+            </details>
+          </div>
+        </section>
+        <div>
+          <div id="simres" aria-live="polite"></div>
+          <div id="hist"></div>
+        </div>
+      </div>
+    </section>
+
+    <!-- Administración de respuestas (consultar, editar, eliminar): se dibuja en js/panel/registros.js -->
+    <section class="vista" id="v-registros" hidden>
+      <div id="registros"></div>
+    </section>
+  </main>
+</div>
+
+<!-- Diálogos de la administración de respuestas: ficha, edición, confirmación de borrado y clave -->
+<dialog id="dlg" class="dlg" aria-labelledby="dlg-titulo"></dialog>
+<dialog id="dlg-clave" class="dlg dlg-chico" aria-labelledby="dlg-clave-titulo"></dialog>
+<script type="module" src="js/panel/main.js"></script>
+</body>
+</html>
diff --git a/Arcusur/app/classes/static/encuesta.css b/Arcusur/app/classes/static/encuesta.css
new file mode 100644
index 0000000..f86c080
--- /dev/null
+++ b/Arcusur/app/classes/static/encuesta.css
@@ -0,0 +1,79 @@
+/* Estilos de la pantalla de encuestas (index.html). Colores base en variables: tinta, verde institucional, fondo y bordes. */
+:root{--ink:#14202e;--teal:#0f766e;--bg:#eef2f5;--line:#cdd6df;--soft:#e3f2f0;--mut:#52606f;
+/* Medidas comunes: cuadros de opción, campos y botones miden lo mismo */
+--ctl:52px;--r:10px}
+*{box-sizing:border-box}
+body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.55 "Segoe UI",system-ui,sans-serif}
+/* Barra superior y contenedor central */
+.top{display:flex;justify-content:space-between;align-items:center;gap:8px 20px;flex-wrap:wrap;padding:14px 20px;background:var(--ink);color:#fff}
+.top strong{white-space:nowrap}
+.top a{color:#cfe8e5;text-decoration:none;font-size:15px}
+main{max-width:680px;margin:28px auto 60px;padding:0 14px}
+/* Tarjeta blanca que contiene cada pantalla */
+.card{background:#fff;border-radius:14px;padding:28px;box-shadow:0 2px 14px rgba(20,32,46,.08)}
+h1{font-size:28px;line-height:1.2;margin:0 0 10px}
+p{margin:0 0 16px;color:var(--mut)}
+/* Pantalla de inicio: botones grandes para elegir encuesta */
+.choose{display:grid;gap:12px;margin-top:20px}
+.choose button{display:grid;text-align:left;gap:2px;padding:18px 20px;font:inherit;font-size:19px;font-weight:600;background:#fff;color:var(--ink);border:2px solid var(--line);border-radius:12px;cursor:pointer}
+.choose button span{font-size:15px;font-weight:400;color:var(--mut)}
+.choose button:hover{border-color:var(--teal);background:var(--soft)}
+/* Barra de progreso y etiqueta del paso */
+.prog{height:8px;background:var(--line);border-radius:8px;overflow:hidden}
+#bar{height:100%;width:0;background:var(--teal)}
+.paso{margin:10px 0 22px;font-size:15px;font-weight:600;color:var(--teal)}
+/* Cada pregunta es un fieldset: enunciado (legend) + opciones */
+fieldset{border:0;padding:0;margin:0 0 26px}
+legend{font-size:19px;font-weight:600;line-height:1.35;margin-bottom:12px;padding:0}
+/* Opciones de respuesta: cuadrícula; las opciones de una fila se estiran para tener la misma altura */
+.opts{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:10px}
+label{position:relative;display:block}
+input[type=radio]{position:absolute;opacity:0;width:100%;height:100%;margin:0;cursor:pointer}
+/* Cuadros de opción: mismo alto mínimo, texto centrado verticalmente y ancho completo */
+.opts{align-items:stretch}
+.opts label{display:flex}
+.opts span{display:flex;align-items:center;width:100%;min-height:var(--ctl);padding:12px 16px;border:2px solid var(--line);border-radius:var(--r);background:#fff;line-height:1.35}
+/* Variantes: lista de una columna (opciones largas) y 4 columnas (escala de acuerdo); en celular, 2 columnas */
+.opts.long{grid-template-columns:1fr}
+.opts.c4{grid-template-columns:repeat(4,1fr)}
+.opts.c4 span{justify-content:center;text-align:center;font-size:15px;padding:12px 8px}
+@media(max-width:560px){.opts.c4{grid-template-columns:repeat(2,1fr)}}
+/* Opción seleccionada */
+.opts input:checked+span{border-color:var(--teal);background:var(--soft);font-weight:600}
+/* Escala Likert numérica (círculos) */
+.lk{display:flex;gap:10px}.lk label{flex:1;max-width:var(--ctl)}
+.lk span{display:grid;place-items:center;width:100%;aspect-ratio:1;border:2px solid var(--line);border-radius:50%;font-weight:600;background:#fff}
+.lk input:checked+span{background:var(--teal);border-color:var(--teal);color:#fff}
+.lkl{display:flex;justify-content:space-between;gap:12px;margin-top:8px;font-size:14px;color:var(--mut)}
+/* Accesibilidad: contorno visible al navegar con teclado; campos de texto, número y lista */
+input[type=radio]:focus-visible+span,input[type=number]:focus-visible,input:not([type]):focus-visible,select:focus-visible,button:focus-visible{outline:3px solid var(--teal);outline-offset:2px}
+input[type=number],input:not([type]),select{width:100%;font:inherit;height:var(--ctl);padding:0 14px;border:2px solid var(--line);border-radius:var(--r);background:#fff;color:var(--ink)}
+/* Mensaje de error y botones de navegación */
+#err{min-height:24px;margin:0 0 12px;color:#b42318;font-weight:600}
+.nav{display:flex;justify-content:space-between;gap:12px}
+.nav button,#otra{min-height:var(--ctl);padding:0 26px;font:inherit;font-weight:600;border:0;border-radius:var(--r);background:var(--teal);color:#fff;cursor:pointer}
+.nav .sec{background:#fff;color:var(--ink);border:2px solid var(--line)}
+#sig{margin-left:auto}
+/* Los elementos con atributo hidden nunca se muestran */
+[hidden]{display:none!important}
+@media(max-width:480px){.card{padding:20px}h1{font-size:24px}.lk{gap:6px}}
+@media(prefers-reduced-motion:no-preference){#bar{transition:width .3s}}
+/* Casillas de elección múltiple, correo y teléfono, campos "Otro" y contador de opciones */
+input[type=checkbox]{position:absolute;opacity:0;width:100%;height:100%;margin:0;cursor:pointer}
+input[type=checkbox]:focus-visible+span{outline:3px solid var(--teal);outline-offset:2px}
+input[type=checkbox]:disabled+span{opacity:.45}
+input[type=email],input[type=tel]{width:100%;font:inherit;height:var(--ctl);padding:0 14px;border:2px solid var(--line);border-radius:var(--r);background:#fff;color:var(--ink)}
+input[type=email]:focus-visible,input[type=tel]:focus-visible{outline:3px solid var(--teal);outline-offset:2px}
+fieldset input[name$=_otro],fieldset input[name$=_otra]{margin-top:10px}
+.cnt{margin:8px 0 0;font-size:14px;font-weight:600;color:var(--teal)}
+.desc{margin:0 0 24px;font-size:15px}
+/* Cuadro de texto largo (respuestas abiertas) */
+textarea{width:100%;font:inherit;padding:13px 14px;border:2px solid var(--line);border-radius:10px;background:#fff;color:var(--ink);resize:vertical}
+textarea:focus-visible{outline:3px solid var(--teal);outline-offset:2px}
+/* Navegación superior y botones de enlace (.btn) */
+.top nav{display:flex;gap:20px}
+.top nav a{white-space:nowrap}
+.fin-nav{display:flex;flex-wrap:wrap;gap:12px;margin-top:20px}
+.btn{display:inline-flex;align-items:center;min-height:var(--ctl);padding:0 26px;font:inherit;font-weight:600;border-radius:var(--r);background:#fff;color:var(--ink);border:2px solid var(--line);text-decoration:none}
+.btn:hover{border-color:var(--teal);background:var(--soft)}
+.btn:focus-visible{outline:3px solid var(--teal);outline-offset:2px}
diff --git a/Arcusur/app/classes/static/index.html b/Arcusur/app/classes/static/index.html
new file mode 100644
index 0000000..5f4d269
--- /dev/null
+++ b/Arcusur/app/classes/static/index.html
@@ -0,0 +1,69 @@
+<!doctype html>
+<html lang="es">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width,initial-scale=1">
+  <title>Encuesta de seguimiento · Ingeniería de Sistemas UMSS</title>
+  <link rel="stylesheet" href="css/base.css">
+  <link rel="stylesheet" href="css/encuesta.css">
+</head>
+<body>
+<header class="top">
+  <strong>Ingeniería de Sistemas · UMSS</strong>
+  <nav><a href="index.html">Encuestas</a><a href="dashboard.html">Panel de análisis</a><a href="dashboard.html#registros">Administrar respuestas</a></nav>
+</header>
+<main>
+  <!-- Pantalla 1: elegir qué encuesta responder -->
+  <section id="inicio" class="hoja">
+    <h1>Encuesta de seguimiento de la Carrera</h1>
+    <p>Los resultados alimentan el Plan de Desarrollo Estratégico (ARCUSUR) y se usan solo con fines académicos. El correo se pide únicamente para evitar respuestas duplicadas. Las preguntas se adaptan a sus respuestas.</p>
+    <div class="choose">
+      <button type="button" data-k="titulados">Titulados<span>Egresados de Ingeniería de Sistemas · unos 8 minutos</span></button>
+      <button type="button" data-k="empleadores">Empleadores<span>Empresas e instituciones que contratan profesionales · unos 8 minutos</span></button>
+    </div>
+  </section>
+
+  <!-- Pantalla 2: formulario por pasos; js/encuesta/formulario.js dibuja las preguntas dentro de #campos -->
+  <form id="f" class="hoja" hidden novalidate>
+    <div class="prog"><div id="bar"></div></div>
+    <p id="paso" class="paso"></p>
+    <div id="campos"></div>
+    <p id="err" role="alert"></p>
+    <div class="nav">
+      <button type="button" id="atras" class="btn">Atrás</button>
+      <button id="sig" class="btn btn-primario">Siguiente</button>
+    </div>
+  </form>
+
+  <!-- Pantalla 3: revisión. Muestra con qué nombre se guardará la respuesta y un resumen antes de enviarla -->
+  <section id="revision" class="hoja" hidden>
+    <p class="paso">Último paso · Revise y confirme</p>
+    <h1>Confirme su respuesta</h1>
+    <p>Su respuesta se guardará con el nombre que aparece abajo. Cada correo puede responder una sola vez.</p>
+    <div class="registro-nombre">
+      <small>Se guardará como</small>
+      <strong id="rev-nombre"></strong>
+      <span id="rev-detalle"></span>
+    </div>
+    <details class="rev-resp" open>
+      <summary>Sus respuestas</summary>
+      <dl id="rev-lista"></dl>
+    </details>
+    <p id="rev-err" role="alert"></p>
+    <div class="nav">
+      <button type="button" id="rev-atras" class="btn">Volver y corregir</button>
+      <button type="button" id="rev-ok" class="btn btn-primario">Confirmar y guardar</button>
+    </div>
+  </section>
+
+  <!-- Pantalla 4: confirmación de lo guardado -->
+  <section id="fin" class="hoja" hidden>
+    <h1>Respuesta registrada</h1>
+    <p>Gracias por participar. Su respuesta quedó guardada con estos datos:</p>
+    <dl class="ficha" id="fin-ficha"></dl>
+    <div class="fin-nav"><button type="button" id="otra" class="btn btn-primario">Responder otra encuesta</button></div>
+  </section>
+</main>
+<script type="module" src="js/encuesta/formulario.js"></script>
+</body>
+</html>
diff --git a/Arcusur/app/classes/static/js/encuesta/formulario.js b/Arcusur/app/classes/static/js/encuesta/formulario.js
new file mode 100644
index 0000000..295155d
--- /dev/null
+++ b/Arcusur/app/classes/static/js/encuesta/formulario.js
@@ -0,0 +1,280 @@
+// Lógica del formulario: dibuja cada paso, valida las respuestas y las envía a la API.
+import { OPC, PASOS, NUM, L3, L4 } from "./preguntas.js";
+
+// Variables: k = encuesta elegida, i = paso actual, D = respuestas acumuladas.
+// vs() devuelve los pasos que corresponden según las respuestas (omite los condicionales que no aplican).
+// val(n) lee el valor actual de un campo; vis(c) indica si una pregunta debe mostrarse.
+
+const $ = (id) => document.getElementById(id),
+  f = $("f"),
+  err = (m) => {
+    $("err").textContent = m;
+  };
+let k, i, D;
+const vs = () => PASOS[k].filter((s) => !s.w || (D[s.w[0]] || "").startsWith(s.w[1]));
+const val = (n) => {
+    const e = f.elements[n];
+    return e ? e.value : (D[n] ?? "");
+  },
+  vis = (c) => !c.w || val(c.w[0]).startsWith(c.w[1]);
+// lg(): si alguna opción es larga, la lista se muestra en una sola columna para que todos los cuadros queden alineados.
+const lg = (a) => (a.some((x) => x.length > 40) ? " long" : "");
+// campo(c): genera el HTML de una pregunta según su tipo.
+function campo(c) {
+  const { n, l, t } = c,
+    o = c.o || OPC[n];
+  let h = `<fieldset id="fs-${n}"${c.max ? ` data-max="${c.max}"` : ""}><legend>${l}</legend>`;
+  if (t == "n")
+    h += `<input type="number" name="${n}" inputmode="decimal" min="0" max="60" step="any" placeholder="Ej. 3">`;
+  else if (t == "t") h += `<input name="${n}" maxlength="500">`;
+  else if (t == "e") h += `<input type="email" name="${n}" maxlength="120" placeholder="nombre@correo.com">`;
+  else if (t == "p") h += `<input type="tel" name="${n}" maxlength="30" placeholder="7XXXXXXX">`;
+  else if (t == "a") h += `<textarea name="${n}" rows="4" maxlength="1500"></textarea>`;
+  else if (t == "l3")
+    h += `<div class="opts c4">${L3.map(([x, v]) => `<label><input type="radio" name="${n}" value="${v}"><span>${x}</span></label>`).join("")}</div>`;
+  else if (t == "m")
+    h +=
+      `<div class="opts${lg(o)}">${o.map((x) => `<label><input type="checkbox" name="${n}" value="${x}"><span>${x}</span></label>`).join("")}</div>` +
+      (c.otra
+        ? `<input name="${n}_otra" maxlength="120" placeholder="${typeof c.otra == "string" ? c.otra : "Otra asignatura (opcional)"}">`
+        : "") +
+      (c.max ? `<p class="cnt" id="cnt-${n}"></p>` : "");
+  else if (t == "l4")
+    h += `<div class="opts">${L4.map((x, j) => `<label><input type="radio" name="${n}" value="${j + 1}"><span>${x}</span></label>`).join("")}</div>`;
+  else if (o.length > 6)
+    h += `<select name="${n}"><option value="">Seleccione…</option>${o.map((x) => `<option>${x}</option>`).join("")}</select>`;
+  else
+    h += `<div class="opts${lg(o)}">${o.map((x) => `<label><input type="radio" name="${n}" value="${x}"><span>${x}</span></label>`).join("")}</div>`;
+  if (o && o.some((x) => x.endsWith(":")))
+    h += `<input id="ot-${n}" name="${n}_otro" maxlength="120" placeholder="Especifique" hidden>`;
+  return h + "</fieldset>";
+}
+// leer(): guarda en D las respuestas del paso actual (y borra las de preguntas que quedaron ocultas).
+function leer() {
+  const fd = new FormData(f);
+  vs()[i].c.forEach((c) => {
+    if (!vis(c)) {
+      ["", "_otro", "_otra"].forEach((s) => delete D[c.n + s]);
+      return;
+    }
+    D[c.n] = c.t == "m" ? fd.getAll(c.n).join("|") : fd.get(c.n) || "";
+    ["_otro", "_otra"].forEach((s) => {
+      if (fd.has(c.n + s)) D[c.n + s] = fd.get(c.n + s);
+    });
+  });
+}
+// actualizar(): muestra u oculta preguntas condicionales, el campo "Especifique" y el contador de opciones.
+function actualizar() {
+  vs()[i].c.forEach((c) => {
+    const fs = $("fs-" + c.n);
+    fs.hidden = !vis(c);
+    const ot = $("ot-" + c.n);
+    if (ot) ot.hidden = !val(c.n).endsWith(":");
+    if (c.max) {
+      const cb = [...fs.querySelectorAll("input[type=checkbox]")],
+        oa = f.elements[c.n + "_otra"],
+        n = cb.filter((b) => b.checked).length + (oa && oa.value.trim() ? 1 : 0);
+      cb.forEach((b) => (b.disabled = !b.checked && n >= c.max));
+      $("cnt-" + c.n).textContent = `Seleccionadas: ${n} de ${c.max}`;
+    }
+  });
+}
+// mostrar(): dibuja el paso actual con su barra de progreso, descripción y botones Atrás/Siguiente.
+function mostrar() {
+  const p = vs(),
+    st = p[i];
+  $("paso").textContent = `Paso ${i + 1} de ${p.length} · ${st.t}`;
+  $("bar").style.width = ((i + 1) / p.length) * 100 + "%";
+  $("campos").innerHTML = (st.d ? `<p class="desc">${st.d}</p>` : "") + st.c.map(campo).join("");
+  st.c.forEach((c) => {
+    const e = f.elements[c.n],
+      v = D[c.n];
+    if (e && v != null) {
+      if (c.t == "m") {
+        const s = v.split("|");
+        [...e].forEach((b) => (b.checked = s.includes(b.value)));
+      } else e.value = v;
+    }
+    ["_otro", "_otra"].forEach((s) => {
+      const x = f.elements[c.n + s];
+      if (x && D[c.n + s]) x.value = D[c.n + s];
+    });
+  });
+  actualizar();
+  $("atras").textContent = i == 0 ? "Volver al inicio" : "Atrás";
+  $("sig").textContent = i == p.length - 1 ? "Enviar respuesta" : "Siguiente";
+  err("");
+  window.scrollTo(0, 0);
+}
+// Cada cambio en el formulario vuelve a evaluar qué preguntas se muestran.
+f.addEventListener("input", actualizar);
+f.addEventListener("change", actualizar);
+// Botón Atrás: en el primer paso vuelve al inicio; en los demás retrocede un paso.
+$("atras").onclick = () => {
+  if (i == 0) {
+    inicio();
+    return;
+  }
+  leer();
+  i--;
+  mostrar();
+};
+// inicio(): vuelve a la pantalla de elección de encuesta y limpia el #hash de la dirección.
+function inicio() {
+  f.hidden = true;
+  $("revision").hidden = true;
+  $("fin").hidden = true;
+  $("inicio").hidden = false;
+  history.replaceState(null, "", location.pathname);
+  window.scrollTo(0, 0);
+}
+// Elegir una encuesta en la pantalla de inicio: reinicia las respuestas y muestra el primer paso.
+document.querySelectorAll("[data-k]").forEach(
+  (b) =>
+    (b.onclick = () => {
+      k = b.dataset.k;
+      i = 0;
+      D = {};
+      $("inicio").hidden = true;
+      f.hidden = false;
+      mostrar();
+    }),
+);
+// "Responder otra encuesta" (pantalla final) también vuelve al inicio.
+$("otra").onclick = inicio;
+// Si la dirección trae #titulados o #empleadores, abre esa encuesta directamente.
+if (["titulados", "empleadores"].includes(location.hash.slice(1)))
+  document.querySelector(`[data-k=${location.hash.slice(1)}]`).click();
+// Botón Siguiente / Enviar: valida el paso; si es el último, arma el objeto y lo envía a la API.
+f.onsubmit = async (e) => {
+  e.preventDefault();
+  leer();
+  const st = vs()[i];
+  // Validación del paso: toda pregunta visible es obligatoria (salvo las marcadas opt).
+  for (const c of st.c) {
+    if (!vis(c)) continue;
+    const v = String(D[c.n] || "").trim();
+    if (c.t == "m") {
+      const n = (v ? v.split("|").length : 0) + ((D[c.n + "_otra"] || "").trim() ? 1 : 0);
+      if (c.max ? n != c.max : n == 0)
+        return err(
+          c.max ? `Seleccione exactamente ${c.max} opciones: ${c.l}` : "Seleccione al menos una opción en: " + c.l,
+        );
+      continue;
+    }
+    if (!v) {
+      if (c.opt) continue;
+      return err("Falta responder: " + c.l);
+    }
+    if (!c.t && v.endsWith(":") && !(D[c.n + "_otro"] || "").trim()) return err("Especifique su respuesta en: " + c.l);
+    if (c.t == "n" && (isNaN(+v) || +v < 0 || +v > 60)) return err("Ingrese un número entre 0 y 60");
+    if (c.t == "e" && !/^\S+@\S+\.\S+$/.test(v)) return err("Ingrese un correo válido");
+  }
+  // Regla de coherencia: no se puede haber estado desempleado más años que los de vida profesional.
+  if (+D.aniosDesempleado > +D.aniosProfesionales)
+    return err("El tiempo desempleado no puede superar sus años de vida profesional.");
+  // Si quedan pasos, avanza; si era el último, continúa con el envío.
+  if (i < vs().length - 1) {
+    i++;
+    mostrar();
+    return;
+  }
+  // Arma el objeto a enviar: solo preguntas visibles y respondidas; concatena el texto de "Otros"; convierte a número los campos de NUM.
+  const d = {};
+  vs().forEach((s) =>
+    s.c.forEach((c) => {
+      if (!vis(c)) return;
+      let v = D[c.n];
+      if (v == null || v === "") return;
+      const o = (D[c.n + "_otro"] || "").trim(),
+        a = (D[c.n + "_otra"] || "").trim();
+      if (o && String(v).endsWith(":")) v += " " + o;
+      if (a) v = (v ? v + "|" : "") + "Otra: " + a;
+      d[c.n] = NUM.includes(c.n) ? +v : v;
+    }),
+  );
+  revisar(d);
+};
+
+// ---------------------------------------------------------------------------
+// Revisión y guardado
+// ---------------------------------------------------------------------------
+// enviado: respuesta lista para guardar, mientras la persona la revisa.
+let enviado;
+// nombreDe(d): nombre con el que queda identificada la respuesta (el servidor guarda el correo en minúsculas).
+const nombreDe = (d) => {
+  const mail = d.email.trim().toLowerCase();
+  return k == "titulados" ? `Titulado · ${mail}` : `Empleador · ${d.empresa.trim()} · ${mail}`;
+};
+// fecha(iso): fecha y hora legibles a partir de la marca ISO 8601 que asigna el servidor.
+const fecha = (iso) => {
+  const t = new Date(String(iso).replace(/(\.\d{3})\d+/, "$1"));
+  return isNaN(t) ? String(iso) : t.toLocaleString("es-BO", { dateStyle: "long", timeStyle: "short" });
+};
+// textoRespuesta(c, v): cómo se muestra una respuesta guardada (las escalas se guardan como número).
+const textoRespuesta = (c, v) =>
+  c.t == "l4" ? (L4[v - 1] ?? v) : c.t == "l3" ? (L3.find(([, x]) => x == v) || [v])[0] : c.t == "m" ? String(v).split("|").join(", ") : String(v);
+// fila(dl, titulo, valor): agrega un par título/valor a una lista de definiciones (con textContent: nada se interpreta como HTML).
+const fila = (dl, t, v) => {
+  const dt = document.createElement("dt"),
+    dd = document.createElement("dd");
+  dt.textContent = t;
+  dd.textContent = v;
+  dl.append(dt, dd);
+};
+// revisar(d): en vez de enviar de inmediato, muestra con qué nombre se guardará y el resumen de lo respondido.
+function revisar(d) {
+  enviado = d;
+  $("rev-nombre").textContent = nombreDe(d);
+  $("rev-detalle").textContent =
+    (k == "titulados" ? "Encuesta de titulados" : "Encuesta de empleadores") + " · el nombre se forma con su correo";
+  const dl = $("rev-lista");
+  dl.replaceChildren();
+  vs().forEach((s) =>
+    s.c.forEach((c) => {
+      if (d[c.n] != null) fila(dl, c.l, textoRespuesta(c, d[c.n]));
+    }),
+  );
+  $("rev-err").textContent = "";
+  f.hidden = true;
+  $("revision").hidden = false;
+  window.scrollTo(0, 0);
+}
+// "Volver y corregir": regresa al último paso con todas las respuestas intactas.
+$("rev-atras").onclick = () => {
+  $("revision").hidden = true;
+  f.hidden = false;
+  mostrar();
+};
+// "Confirmar y guardar": envía a la API (POST /api/titulados o /api/empleadores) y muestra la ficha de lo guardado.
+$("rev-ok").onclick = async () => {
+  const b = $("rev-ok");
+  b.disabled = true;
+  $("rev-err").textContent = "";
+  try {
+    const r = await fetch("/api/" + k, {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify(enviado),
+    });
+    // 409 = ese correo ya respondió: el servidor envía el mensaje y se muestra tal cual.
+    if (!r.ok) {
+      const j = await r.json().catch(() => ({}));
+      throw r.status == 409 && j.message ? j.message : 0;
+    }
+    const g = await r.json();
+    const ficha = $("fin-ficha");
+    ficha.replaceChildren();
+    fila(ficha, "Guardada como", nombreDe(g));
+    fila(ficha, "Registro n.º", g.id);
+    fila(ficha, "Correo", g.email);
+    fila(ficha, "Fecha y hora", fecha(g.registrado));
+    $("revision").hidden = true;
+    $("fin").hidden = false;
+    window.scrollTo(0, 0);
+  } catch (x) {
+    $("rev-err").textContent =
+      typeof x == "string" ? x + " Pulse «Volver y corregir» para usar otro correo." : "No se pudo guardar. Revise su conexión e inténtelo de nuevo.";
+  }
+  b.disabled = false;
+};
diff --git a/Arcusur/app/classes/static/js/encuesta/preguntas.js b/Arcusur/app/classes/static/js/encuesta/preguntas.js
new file mode 100644
index 0000000..591adca
--- /dev/null
