+const sinNumero = (s) => s.replace(/^\d+\)\s*/, "");
+const DEF_E = [
+  ["fecha", /^marca temporal/], ["email", /^direccion de correo/], ["empresa", /^nombre de la empresa/],
+  ["tipo", /^tipo de organizacion/], ["tamano", /^tamano de la organizacion/], ["rubro", /^indique el rubro/],
